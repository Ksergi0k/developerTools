                      <value name="htmlContent">&lt;button onclick=&quot;generatePass()&quot; id=&quot;genBtn&quot; class=&quot;agg-btn auxiliary&quot; style=&quot;margin:5px;max-width:120px;&quot;&gt;Сгенерировать&lt;/button&gt;&#xd;
&lt;br/&gt;&#xd;
&lt;span&gt;Длина: &lt;/span&gt;&lt;br/&gt;&lt;input type=&quot;number&quot; id=&quot;lenght&quot; class=&quot;ant-input&quot; style=&quot;margin:5px; width:100px&quot; value=&quot;14&quot;&gt;&#xd;
&lt;br/&gt;&#xd;
&lt;span&gt;Спец. символы: &lt;/span&gt;&lt;br/&gt;&lt;input type=&quot;text&quot; id=&quot;spec&quot; class=&quot;ant-input&quot; style=&quot;margin:5px; width:100px&quot; value=&quot;!@#_&amp;$%&quot;&gt;&#xd;
&lt;br/&gt;&#xd;
&lt;span&gt;Пароль: &lt;/span&gt;&lt;br/&gt;&lt;input id=&quot;myPassword&quot; class=&quot;ant-input&quot; style=&quot;margin:5px; width:400px&quot; value=&quot;&quot; readonly&gt;&#xd;
&#xd;
&lt;script&gt;&#xd;
    function generatePass() {&#xd;
        const lengthInput = document.querySelector(&quot;#lenght&quot;);&#xd;
        const specInput = document.querySelector(&quot;#spec&quot;);&#xd;
        const passwordInput = document.querySelector(&quot;#myPassword&quot;);&#xd;
&#xd;
        // Защита: если элементы не найдены, выходим&#xd;
        if (!lengthInput || !specInput || !passwordInput) {&#xd;
            console.warn(&quot;Элементы формы не найдены&quot;);&#xd;
            return;&#xd;
        }&#xd;
&#xd;
        const pLength = parseInt(lengthInput.value, 10) || 14;&#xd;
        const keyListAlpha = &quot;abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ&quot;;&#xd;
        const keyListInt = &quot;123456789&quot;;&#xd;
        const keyListSpec = specInput.value;&#xd;
        let password = &apos;&apos;;&#xd;
&#xd;
        // Логика генерации&#xd;
        const len = Math.ceil(pLength / 2) - 1;&#xd;
        const lenSpec = pLength - 2 * len;&#xd;
&#xd;
        for (let i = 0; i &lt; len; i++) {&#xd;
            password += keyListAlpha.charAt(Math.floor(Math.random() * keyListAlpha.length));&#xd;
            password += keyListInt.charAt(Math.floor(Math.random() * keyListInt.length));&#xd;
        }&#xd;
&#xd;
        for (let i = 0; i &lt; lenSpec; i++) {&#xd;
            if (keyListSpec.length &gt; 0) {&#xd;
                password += keyListSpec.charAt(Math.floor(Math.random() * keyListSpec.length));&#xd;
            }&#xd;
        }&#xd;
&#xd;
        // Перемешивание&#xd;
        password = password.split(&apos;&apos;).sort(() =&gt; 0.5 - Math.random()).join(&apos;&apos;);&#xd;
        passwordInput.value = password;&#xd;
    }&#xd;
    generatePass();&#xd;
&lt;/script&gt;</value>
