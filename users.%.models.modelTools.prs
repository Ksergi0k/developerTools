                        </defaultValue>
                      </field>
                      <field description="Formats" name="formats" type="T">
                        <defaultValue>
                          <table>
                            <format maxRecords="2147483647">
                              <fields>
                                <field description="ID" keyfield="true" name="id" type="L">
                                  <defaultValue>0</defaultValue>
                                </field>
                                <field description="Format" name="format" type="S">
                                  <defaultValue/>
                                </field>
                              </fields>
                            </format>
                            <records>
                              <record>
                                <value name="format">&lt;&gt;&lt;S&gt;&lt;F=NR&gt;&lt;A=&lt;NULL&gt;&gt;&lt;E=textarea&gt;</value>
                              </record>
