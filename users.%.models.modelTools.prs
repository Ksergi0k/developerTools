                      <field description="Reorderable" name="reorderable" type="B">
                        <help>This flag indicates that records in this table may be swapped (re-ordered) during table processing.</help>
                        <defaultValue>1</defaultValue>
                      </field>
                      <field description="Unresizable" name="unresizable" type="B">
                        <help>This flag indicates that users cannot add or remove rows when editing the table.</help>
                        <defaultValue>0</defaultValue>
                      </field>
                      <field description="Bindings" name="bindings" type="T">
                        <help>A list of data bindings that define how the values in the table are changed when other table cells, or environment variables, are changed during table processing.</help>
                        <defaultValue>
