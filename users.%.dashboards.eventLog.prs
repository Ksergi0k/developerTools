                      <field description="Справка" editor="textarea" name="help" nullable="true" type="S">
                        <validators contentType="base64">HFIeW15ccHtDbnRybH1dKl5e0J7Qv9C40YHQsNC90LjQtSDQvNC+0LbQtdGCINGB0L7QtNC10YDQttCw0YLRjCDRgtC+0LvRjNC60L4g0L/QtdGH0LDRgtC90YvQtSDRgdC40LzQstC+0LvRix0=</validators>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
