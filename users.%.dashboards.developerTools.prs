.dock-left &gt; div &gt; div .dock-nav-wrap{
  order:1;
}

td,th{
  padding:2px!important;
}

.help-text {
    padding: 2px;
    margin: 0;
    border-left: 2px solid #edd262;
    font-size: 10px;
}

.dockable-layout.dock-panel &gt; .dock-top &gt; .dock-bar.dockable-layout {
    height: 28px!important;
}

.open-grid-dashboard-procedure {
    margin-top: 4px;
 }
.ant-tabs .ant-tabs-nav .ant-tabs-tab {
    padding: 8px 4px;
}

.dockable-layout.dock-panel&gt;.dock-top&gt;.dock-bar.dockable-layout .dock-tab.dockable-layout {
  padding: 4px;
}

.dockable-layout.dock-panel&gt;.dock-top&gt;.dock-content-holder{
  padding: 8px;
}

.dockable-custom-preview.dockable-custom-preview-top&gt;.dock-bar.dockable-layout, .dockable-layout.dock-panel&gt;.dock-top&gt;.dock-bar.dockable-layout {
  height: 34px;
}

.agg-btn.main {
  color: white;
}

.input--disclaimer span{
  font-size: 16px;
}

.input--disclaimer &gt; .container-scrolling {
  justify-content: center;
}

.dockable-expression-builder-layout.dock-panel&gt;.dock-top&gt;.dock-content-holder {
  padding: 2px;
}

.dockable-layout.dock-panel &gt; .dock-top &gt; .dock-content-holder {
    padding: 2px;
}</value>
