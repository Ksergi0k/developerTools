      <entry>
        <int>45</int>
        <format maxRecords="2147483647" reorderable="true">
          <fields>
            <field description="Type" hidden="true" name="type" type="S">
              <selectionValues>
                <option description="Tag">tag</option>
              </selectionValues>
              <defaultValue>tag</defaultValue>
            </field>
            <field description="Tag Name" extendableSelectionValues="true" name="name" nullable="true" type="S">
              <selectionValues>
                <option description="title">title</option>
                <option description="base">base</option>
                <option description="link">link</option>
                <option description="style">style</option>
                <option description="meta">meta</option>
                <option description="script">script</option>
                <option description="noscript">noscript</option>
                <option description="template">template</option>
              </selectionValues>
              <help>Defines the name of the tag.</help>
              <defaultValue>meta</defaultValue>
            </field>
            <field description="Tag Attributes" name="attributes" nullable="true" type="T">
              <help>Defines a list of tag attributes.</help>
              <defaultValue>
                <table>
                  <format maxRecords="2147483647" reorderable="true">
                    <fields>
                      <field description="Name" name="attributeName" type="S">
                        <help>Defines the tag attribute name.</help>
                        <defaultValue/>
                      </field>
                      <field description="Value Expression" editor="expression" name="attributeValueExpression" type="S">
                        <editorOptions contentType="base64"></editorOptions>
                        <help>An expression which evaluates to the tag attribute value string.</help>
                        <defaultValue/>
                      </field>
                    </fields>
                  </format>
                </table>
              </defaultValue>
            </field>
            <field description="Content Expression" editor="expression" name="contentExpression" nullable="true" type="S">
              <editorOptions contentType="base64"></editorOptions>
              <help>An expression that must evaluate to a string, which is processed as the tag content value. The expression is evaluated at the moment the dashboard is being opened. Evaluation result is HTML-escaped before inserted into the HTML markup.</help>
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
          </fields>
          <bindings>
            <binding>
              <reference>name#enabled</reference>
              <expression>{type} == &quot;tag&quot;</expression>
            </binding>
            <binding>
              <reference>attributes#enabled</reference>
              <expression>{type} == &quot;tag&quot;</expression>
            </binding>
          </bindings>
        </format>
      </entry>
      <entry>
