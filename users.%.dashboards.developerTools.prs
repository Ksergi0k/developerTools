.ant-table-body
.expression-editor-container 
.text-area
,.agg-textarea.agg-textarea {
    width: 100%;
    height: 10rem;
}
.tooltip-wrapper{
    width: 100%;
}
.comments{
    grid-row:1;    
    grid-column: 2;
}
.expression{
    grid-row:2;    
    grid-column: 2;
}
.result{
    grid-row:3;    
    grid-column: 2;
}
.duration{
    grid-row:4;    
    grid-column: 2;
}

thead &gt;tr&gt; th:not(.ant-table-cell-fix-left){
    display: none;
}

.agg-table-wrapper .ant-table-body .expression-editor-container .text-area {
    color: var(--geekblue-10);
    font-family: &apos;Roboto&apos;;
}

.agg-table-wrapper .ant-table-body .ant-dropdown-trigger {
    width: 100%;
}
.agg-table-wrapper .ant-table-body .ant-table-tbody&gt;tr.ant-table-row&gt;td {
   height: fit-content;
}
.data-table-row {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto 1fr auto;
    padding-bottom: 30px;
}
.ant-table-row{
    width: fit-content;
}

.kebab-block-buttons:hover {
    outline: 2px outset var(--criticalActionHoverColor);
}

.toolbar-reset-button {
    display: none;
}

.agg-table-wrapper .ant-table-body .ant-table-tbody&gt;tr.ant-table-row&gt;td:first-child.ant-table-selection-column{
    min-width: 0px;
    width: 100%;
}

table{
    table-layout: unset!important;
}*~*</value>
