	? (
		setVariable({env/bulkContext}, &quot;elements&quot;, set(
	{env/bulkEnvelope}
	,&quot;parameters&quot;
	,match(&quot;&quot;, subtable({env/bulkEnvelope}, &quot;name&quot;), 0, true)
