                                            <defaultValue>
                                              <nullValue/>
                                            </defaultValue>
                                          </field>
                                          <field description="Background Color" name="backgroundColor" nullable="true" type="C">
                                            <defaultValue>
                                              <nullValue/>
                                            </defaultValue>
                                          </field>
                                          <field description="Vertical Alignment" name="verticalAlign" type="S">
                                            <selectionValues>
                                              <option description="Top">top</option>
                                              <option description="Middle">middle</option>
                                              <option description="Bottom">bottom</option>
                                            </selectionValues>
                                            <defaultValue>top</defaultValue>
