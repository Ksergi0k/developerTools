            <field description="Writable" name="writable" type="B">
              <help>The flag indicating that the variable is writable.</help>
              <defaultValue>1</defaultValue>
            </field>
            <field description="Help" name="help" nullable="true" type="S">
              <help>This field is used to specify the detailed variable description.</help>
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
            <field description="Group" name="group" nullable="true" type="S">
              <help>This field defines the variable group. It can be NULL if the variable does not belong to any group.</help>
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
            <field description="Read Permissions" name="readPermissions" type="S">
              <selectionValues>
                <option description="None"/>
                <option description="Observer">observer</option>
                <option description="Operator">operator</option>
                <option description="Manager">manager</option>
                <option description="Engineer">engineer</option>
                <option description="Administrator">admin</option>
              </selectionValues>
              <help>This field specifies the permission level in the model context (or the context the relative model is attached to, or the instantiable model&apos;s instance context) required to read the variable.</help>
              <defaultValue>observer</defaultValue>
            </field>
            <field description="Write Permissions" name="writePermissions" type="S">
              <selectionValues>
                <option description="None"/>
                <option description="Observer">observer</option>
                <option description="Operator">operator</option>
                <option description="Manager">manager</option>
                <option description="Engineer">engineer</option>
                <option description="Administrator">admin</option>
              </selectionValues>
              <help>This field specifies the permission level in the model context (or the context the relative model is attached to, or the instantiable model&apos;s instance context) required to write the variable.</help>
              <defaultValue>manager</defaultValue>
            </field>
            <field description="Storage Mode" name="storageMode" type="I">
              <selectionValues>
                <option description="Database">0</option>
                <option description="Memory">1</option>
              </selectionValues>
              <help>This field defines whether the variable value is persistent (Database storage type) or transient (Memory storage type).</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="History Storage Time" editor="period" name="updateHistoryStorageTime" nullable="true" type="L">
              <editorOptions>3 8</editorOptions>
              <help>This field defines how long the historical values of this variable are stored.</help>
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
            <field advanced="true" description="History Mode/Rate" name="historyRate" type="I">
              <selectionValues>
                <option description="All Values">0</option>
                <option description="Changes Only">-1</option>
              </selectionValues>
              <help>History Rate controls storing and firing updates policy. If it is &apos;Changes Only&apos; then setting the same value for the variable will be ignored. If it is set to &apos;All Values&apos; then any set operation for the variable will be stored and update is fired.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field advanced="true" description="Cache Time" editor="period" name="cacheTime" nullable="true" type="L">
              <editorOptions>0 1</editorOptions>
              <help>Defines minimal period of subsequent remote reads of variable value. If remote components try to read the variable twice during the cache period, 2nd read attempt will retrieve value from the cache. Non-defined value disables caching.</help>
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
            <field advanced="true" description="Server In-memory Value Caching" name="serverCachingMode" type="I">
              <selectionValues>
                <option description="Keep Always">1</option>
                <option description="Keep While Enough Memory">2</option>
              </selectionValues>
              <help>Allows to control how the server cache variable values. Keep Always - variable cache will always hold last written value of the variable. Keep While Enough Memory - variable cache will hold last written value of the variable if server memory consumption is not critical.</help>
              <defaultValue>1</defaultValue>
            </field>
            <field advanced="true" description="Add Previous Value To Variable Update Event" name="addPreviousValueToVariableUpdateEvent" type="B">
              <help>The flag indicating that the update variable event will contain previous variable value</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Inherited Property" name="inheritedMark" type="B">
              <help>Marked properties will be changed accordingly with their parents</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Parent Model" hidden="true" name="parent" nullable="true" type="S">
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
          </fields>
          <validators contentType="base64">HEseHQ==</validators>
        </format>
