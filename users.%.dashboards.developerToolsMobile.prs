                    <value name="style">.dockable-popup__footer{
  border:1px solid rgb(226, 224, 229);
}
.modal-footer{
  margin: 4px 0px;
  justify-content: space-around;
}

.data-table-column{
  width: 100%;
}

.context-tree-external-buttons{
  position: absolute;
  right: 16px;
  background-color: white;
}
.dockable-layout.dock-panel&gt;.dock-top&gt;.dock-content-holder{
  padding: 0px;
}

.dock-bar{
  height: 28px;
}

.dockable-custom-preview.dockable-custom-preview-bottom .dock-tab.dockable-layout, .dockable-custom-preview.dockable-custom-preview-top .dock-tab.dockable-layout, .dockable-layout.dock-panel&gt;.dock-bottom&gt;.dock-bar.dockable-layout .dock-tab.dockable-layout, .dockable-layout.dock-panel&gt;.dock-top&gt;.dock-bar.dockable-layout .dock-tab.dockable-layout {
  padding: 2px;
}

 .dockable-layout.dock-panel&gt;.dock-top&gt;.dock-bar.dockable-layout {
    border-bottom: 1px solid rgb(226, 224, 229);
    background: #fff;
}</value>
