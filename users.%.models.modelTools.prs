                                              <option description="Center">center</option>
                                              <option description="Right">right</option>
                                            </selectionValues>
                                            <defaultValue>
                                              <nullValue/>
                                            </defaultValue>
                                          </field>
                                          <field description="Border Top" name="borderTop" type="S">
                                            <defaultValue/>
                                          </field>
                                          <field description="Border Left" name="borderLeft" type="S">
                                            <defaultValue/>
                                          </field>
                                          <field description="Border Right" name="borderRight" type="S">
                                            <defaultValue/>
                                          </field>
                                          <field description="Border Bottom" name="borderBottom" type="S">
                                            <defaultValue/>
                                          </field>
                                          <field description="Text Transfer" name="textTransfer" type="S">
                                            <defaultValue>trim</defaultValue>
                                          </field>
                                          <field description="Custom Classes" name="customCssClasses" type="S">
                                            <defaultValue/>
                                          </field>
                                        </fields>
                                      </format>
                                      <records>
                                        <record/>
                                      </records>
                                    </table>
                                  </defaultValue>
                                </field>
                              </fields>
                            </format>
                            <records>
