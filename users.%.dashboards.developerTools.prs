                              <value name="expression">st(&quot;bulkRecord&quot;, cell({env/value}, &quot;record&quot;)) != null
&amp;&amp; st(&quot;bulkIndex&quot;, cell({env/bulkRecord}, &quot;row&quot;)) != null
&amp;&amp; st(&quot;bulkContext&quot;, cell({env/bulkRecord}, &quot;context&quot;)) != null
&amp;&amp; st(&quot;bulkEnvelope&quot;, getVariable({env/bulkContext}, &quot;elements&quot;)) != null
&amp;&amp; st(&quot;bulkSource&quot;, cell(select({env/bulkEnvelope}, &quot;parameters&quot;, &quot;name&quot;, &quot;&quot;), &quot;bindings&quot;)) != null
? (
	{env/bulkIndex} &gt;= 0 &amp;&amp; {env/bulkIndex} &lt; records({env/bulkSource})
