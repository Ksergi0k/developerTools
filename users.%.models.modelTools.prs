                      </value>
                    </record>
                  </records>
                </table>
              </value>
              <value name="type">0</value>
              <value name="implementation">import com.tibbo.aggregate.common.context.*;
import com.tibbo.aggregate.common.datatable.*;
import com.tibbo.aggregate.common.server.*;

import com.tibbo.linkserver.*;
import com.tibbo.linkserver.context.*;

public class %ScriptClassNamePattern% implements FunctionImplementation
{
  public DataTable execute(Context con, FunctionDefinition def, CallerController caller, RequestController request, DataTable parameters) throws ContextException
  {
    try
    {
      DataTable sourceTable = parameters.rec().getDataTable(&quot;table&quot;);
      String columnName = parameters.rec().getString(&quot;columnName&quot;);
      String newColumnFormat = parameters.rec().getString(&quot;newColumnFormat&quot;);

      if (sourceTable == null)
      {
        throw new ContextException(&quot;Parameter &apos;table&apos; is null&quot;);
      }

      if (columnName == null || columnName.isEmpty())
      {
        throw new ContextException(&quot;Parameter &apos;columnName&apos; is empty&quot;);
      }

      if (newColumnFormat == null || newColumnFormat.isEmpty())
      {
        throw new ContextException(&quot;Parameter &apos;newColumnFormat&apos; is empty&quot;);
      }

      TableFormat sourceFormat = sourceTable.getFormat();
      TableFormat resultFormat = sourceFormat.clone();

      FieldFormat oldField = resultFormat.getField(columnName);
      if (oldField == null)
      {
        throw new ContextException(&quot;Column not found: &quot; + columnName);
      }

      int fieldIndex = -1;
      for (int i = 0; i &lt; resultFormat.getFieldCount(); i++)
      {
        if (columnName.equals(resultFormat.getField(i).getName()))
        {
          fieldIndex = i;
          break;
        }
      }

      if (fieldIndex &lt; 0)
      {
        throw new ContextException(&quot;Cannot determine index of column: &quot; + columnName);
      }

      FieldFormat newField = FieldFormat.create(newColumnFormat);
      String newFieldName = newField.getName();

      if (newFieldName == null || newFieldName.isEmpty())
      {
        throw new ContextException(&quot;New column format does not contain field name&quot;);
      }

      if (!columnName.equals(newFieldName) &amp;&amp; resultFormat.getField(newFieldName) != null)
      {
        throw new ContextException(&quot;Column with new name already exists: &quot; + newFieldName);
      }

      resultFormat.removeField(columnName);
      resultFormat.addField(newField, fieldIndex);

      DataTable result = new SimpleDataTable(resultFormat);

      for (DataRecord sourceRecord : sourceTable)
      {
        DataRecord resultRecord = result.addRecord();
        resultRecord.setId(sourceRecord.getId());
        resultRecord.setIndex(sourceRecord.getIndex());

        for (int i = 0; i &lt; resultFormat.getFieldCount(); i++)
        {
          String targetFieldName = resultFormat.getField(i).getName();

          if (targetFieldName.equals(newFieldName))
          {
            resultRecord.setValue(targetFieldName, sourceRecord.getValue(columnName));
          }
          else if (sourceRecord.getFormat().getField(targetFieldName) != null)
          {
            resultRecord.setValue(targetFieldName, sourceRecord.getValue(targetFieldName));
          }
        }
      }

      return result;
    }
    catch (Exception e)
    {
      throw new ContextException(&quot;Failed to update column format: &quot; + e.getMessage(), e);
    }
  }
}</value>
