<root>
  <properties>
    <properties class="linked-hash-map">
      <entry>
        <string>applicationDependencies</string>
        <table>
          <formatId id="0"/>
        </table>
      </entry>
      <entry>
        <string>childInfo</string>
        <table>
          <formatId id="1"/>
          <records>
            <record>
              <value name="name">developerTools</value>
              <value name="applicationFolderPath">apps\developerTools</value>
            </record>
          </records>
        </table>
      </entry>
      <entry>
        <string>additionalExportImportRules</string>
        <table>
          <formatId id="2"/>
        </table>
      </entry>
      <entry>
        <string>textResources</string>
        <table>
          <formatId id="3"/>
          <records>
            <record/>
          </records>
        </table>
      </entry>
      <entry>
        <string>contextVariables</string>
        <table>
          <formatId id="4"/>
        </table>
      </entry>
      <entry>
        <string>resources</string>
        <table>
          <formatId id="5"/>
          <records>
            <record>
              <value name="resource">users.%.dashboards.developerTools</value>
              <value name="type">dashboard</value>
            </record>
            <record>
              <value name="resource">users.%.dashboards.developerToolsMobile</value>
              <value name="type">dashboard</value>
            </record>
            <record>
              <value name="resource">users.%.dashboards.eventLog</value>
              <value name="type">dashboard</value>
            </record>
            <record>
              <value name="resource">users.%.models.modelTools</value>
              <value name="type">model</value>
            </record>
            <record>
              <value name="resource">users.%.models.userTools</value>
              <value name="type">model</value>
            </record>
          </records>
        </table>
      </entry>
    </properties>
  </properties>
  <formats>
    <formats class="linked-hash-map">
      <entry>
        <int>0</int>
        <format maxRecords="2147483647">
          <fields>
            <field description="Application/Plugin ID" extendableSelectionValues="true" keyfield="true" name="id" type="S">
              <help>ID of another Application required by the application. It should match the name of another application’s context, e.g. &quot;baseApp&quot;.</help>
              <defaultValue/>
            </field>
          </fields>
          <bindings>
            <binding>
              <reference>id#choices</reference>
              <expression>callFunction({.:}, &apos;getPluginIdMap&apos;)</expression>
            </binding>
          </bindings>
          <recordValidators contentType="base64">HEseHQ==</recordValidators>
        </format>
      </entry>
      <entry>
        <int>1</int>
        <format maxRecords="1" minRecords="1">
          <fields>
            <field description="Name" name="name" notReplicated="true" type="S">
              <validators contentType="base64">HEkeHRxMHjEgNTAdHFIeXHcrXl5OYW1lIG1heSBjb250YWluIG9ubHkgTGF0aW4gbGV0dGVycywgZGlnaXRzLCBhbmQgdW5kZXJzY29yZXMd</validators>
              <help>Name of the resource and corresponding system context, required to refer to this resource from other parts of the system. It should satisfy the context naming conventions. WARNING: changing name will corrupt all references to the resource.</help>
              <defaultValue/>
            </field>
            <field description="Description" name="description" notReplicated="true" type="S">
              <validators contentType="base64">HEweMCAxMDAdHFIeW15ccHtDbnRybH1dKl5eRGVzY3JpcHRpb24gbWF5IGNvbnRhaW4gb25seSBwcmludGFibGUgY2hhcmFjdGVycx0=</validators>
              <help>The application context description (the text is displayed in the context tree).</help>
              <defaultValue/>
            </field>
            <field advanced="true" description="Application Folder Path" name="applicationFolderPath" type="S">
              <help>Server folder used for importing/exporting of application files by default.</help>
              <defaultValue/>
            </field>
            <field advanced="true" description="Comment" editor="textarea" name="comment" type="S">
              <help>Any detailed information about the application, such as purpose, recent change history, etc.</help>
              <defaultValue/>
            </field>
            <field description="State" hidden="true" name="state" type="S">
              <selectionValues>
                <option description="Editable">EDITABLE</option>
                <option description="Installed">INSTALLED</option>
                <option description="Deployed">DEPLOYED</option>
                <option description="Deployed with errors">DEPLOYED_WITH_ERRORS</option>
              </selectionValues>
              <defaultValue>EDITABLE</defaultValue>
            </field>
            <field advanced="true" description="Application Home Dashboard" editor="context" name="applicationHomeDashboard" nullable="true" type="S">
              <editorOptions contentType="base64"></editorOptions>
              <help>Indicates which dashboard to open when the Open action is called on the application.</help>
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
            <field advanced="true" description="Disable Simple Mode" name="applicationDisableSimpleMode" type="B">
              <help>When enabled, users with sufficient permissions can open the application without Simple Mode limitations.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field advanced="true" description="Automatic Deployment" name="applicationAutoDeploy" type="B">
              <help>When enabled, the application&apos;s Deploy action will automatically run upon server launch.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field advanced="true" description="Automatic Deployment Parameters" name="applicationAutoDeployParameters" type="T">
              <help>Parameters applied to the Deploy action triggered by the server launch when Automatic Deployment is enabled.</help>
              <defaultValue>
                <table>
                  <format maxRecords="1" minRecords="1">
                    <fields>
                      <field description="Deployment User Mode" name="deploymentUserMode" type="S">
                        <selectionValues>
                          <option description="Application owner">APPLICATION_OWNER</option>
                          <option description="Current user">CURRENT_USER</option>
                          <option description="Select custom user">CUSTOM_USER</option>
                        </selectionValues>
                        <help>Deployment user mode which will be used as resources owner</help>
                        <defaultValue>APPLICATION_OWNER</defaultValue>
                      </field>
                      <field description="Deployment User Context" editor="context" name="deploymentUser" type="S">
                        <editorOptions contentType="base64"></editorOptions>
                        <help>User Context which will be the resources owner in case “Select custom user mode” was chosen</help>
                        <defaultValue/>
                      </field>
                      <field description="Remove orphans" name="deploymentRemoveOrphans" type="B">
                        <help>Remove contexts that were owned and added by the application, but currently do not exist in application resources.</help>
                        <defaultValue>0</defaultValue>
                      </field>
                    </fields>
                  </format>
                </table>
              </defaultValue>
            </field>
          </fields>
        </format>
      </entry>
      <entry>
        <int>2</int>
        <format maxRecords="2147483647">
          <fields>
            <field description="Name" keyfield="true" name="name" type="S">
              <help>Name of the Export / Import Rule which will be also used to name a file containing the data from the Export Expression.</help>
              <defaultValue/>
            </field>
            <field description="Export Expression" editor="expression" name="exportExpression" type="S">
              <editorOptions contentType="base64"></editorOptions>
              <help>Expression which must evaluate to a Data Table. The Data Table will be later passed to the Import Expression as the default table.</help>
              <defaultValue/>
            </field>
            <field description="Import Expression" editor="expression" name="importExpression" type="S">
              <editorOptions contentType="base64"></editorOptions>
              <help>Expression that accepts a Data Table created by the Export Expression and applies it to the server where the application is being deployed. For example, it could create the necessary folders in the media library and import the file-type records into the media library.</help>
              <defaultValue/>
            </field>
          </fields>
          <recordValidators contentType="base64">HEseHQ==</recordValidators>
        </format>
      </entry>
