              <help>This field defines the current function group. It can be NULL if the function does not belong to any group.</help>
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
            <field description="Permissions" name="permissions" type="S">
              <selectionValues>
                <option description="None"/>
                <option description="Observer">observer</option>
                <option description="Operator">operator</option>
                <option description="Manager">manager</option>
                <option description="Engineer">engineer</option>
                <option description="Administrator">admin</option>
              </selectionValues>
              <help>This field defines the permission level in the model context (or the context the relative model is attached to, or the instantable model&apos;s instance context) required to execute the function.</help>
              <defaultValue>operator</defaultValue>
            </field>
            <field description="Execute With Owner&apos;s Permissions" name="ownerPermissions" type="B">
              <help>Specifies that this function should be executed with the permissions of the model context owner</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Type" name="type" type="I">
              <selectionValues>
                <option description="Query">2</option>
                <option description="Expression">1</option>
                <option description="Java Code">0</option>
              </selectionValues>
              <help>This field defines the function implementation type.</help>
              <defaultValue>1</defaultValue>
            </field>
            <field description="Implementation" editor="code" name="implementation" type="S">
              <editorOptions>java</editorOptions>
              <help>This field is available if the Type field is set to Java Code. The Java class source code implements the function body, i.e. does the job that the function is supposed to do.</help>
              <defaultValue>import com.tibbo.aggregate.common.context.*;
import com.tibbo.aggregate.common.datatable.*;
import com.tibbo.aggregate.common.server.*;

import com.tibbo.linkserver.*;
import com.tibbo.linkserver.context.*;

public class %ScriptClassNamePattern% implements FunctionImplementation
{
  public DataTable execute(Context con, FunctionDefinition def, CallerController caller, RequestController request, DataTable parameters) throws ContextException
  {
    return null;
  }
}
</defaultValue>
            </field>
            <field description="Expression" editor="expression" name="expression" type="S">
              <editorOptions contentType="base64"></editorOptions>
              <help>This field is available if the Type field is set to Expression. The expression will be evaluated during the function execution.</help>
              <defaultValue/>
            </field>
            <field description="Query" editor="text" name="query" type="S">
              <editorOptions>sql</editorOptions>
              <help>This field is available if the Type field is set to Query. The query will be evaluated during the function execution.</help>
              <defaultValue/>
            </field>
            <field description="Inherited Property" name="inheritedMark" type="B">
              <help>Marked properties will be changed accordingly with their parents</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Parent Model" hidden="true" name="parent" type="S">
              <defaultValue>false</defaultValue>
            </field>
            <field advanced="true" description="Concurrent" name="concurrent" type="B">
              <help>Defines whether multiple calls of this function can work concurrently.</help>
              <defaultValue>1</defaultValue>
            </field>
            <field advanced="true" description="Plugin" name="plugin" nullable="true" type="S">
              <help>ID of a server plugin that defines the model. Required if function implementation should access plugin&apos;s internal Java classes.</help>
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
          </fields>
          <bindings>
            <binding>
              <reference>implementation#enabled</reference>
              <expression>{type} == 0</expression>
            </binding>
            <binding>
              <reference>expression#enabled</reference>
              <expression>{type} == 1</expression>
            </binding>
            <binding>
              <reference>query#enabled</reference>
              <expression>{type} == 2</expression>
            </binding>
            <binding>
              <reference>plugin#enabled</reference>
              <expression>{type} == 0</expression>
            </binding>
            <binding>
              <reference>expression#options</reference>
              <expression>expressionEditorOptions({childInfo$type[0]} == 0 ? {childInfo$defaultContext[0]} : {.:})</expression>
            </binding>
          </bindings>
          <validators contentType="base64">HEseHQ==</validators>
        </format>
      </entry>
      <entry>
        <int>5</int>
        <format maxRecords="1" minRecords="1" namingExpression="print({fields}, &apos;{name}&apos;, &apos;, &apos;)">
          <fields>
            <field description="Minimal Record Count" name="minRecords" type="I">
              <validators contentType="base64">HEweMCAyMTQ3NDgzNjQ3HQ==</validators>
              <help>The number of records should be within this range, otherwise the table will be treated as &lt;i&gt;invalid&lt;/i&gt;.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Maximal Record Count" extendableSelectionValues="true" name="maxRecords" type="I">
              <validators contentType="base64">HEweMCAyMTQ3NDgzNjQ3HQ==</validators>
              <selectionValues>
                <option description="Not limited">2147483647</option>
              </selectionValues>
              <help>The number of records should be within this range, otherwise the table will be treated as &lt;i&gt;invalid&lt;/i&gt;.</help>
              <defaultValue>2147483647</defaultValue>
            </field>
            <field description="Fields" name="fields" type="T">
              <help>Each row in this property defines a field of the data table.</help>
              <defaultValue>
                <table>
                  <format maxRecords="2147483647" reorderable="true">
                    <fields>
                      <field hidden="true" name="oldname" type="S">
                        <defaultValue/>
                      </field>
                      <field description="Name" keyfield="true" name="name" type="S">
                        <validators contentType="base64">HFIeXHcrXl5OYW1lIG1heSBjb250YWluIG9ubHkgTGF0aW4gbGV0dGVycywgZGlnaXRzLCBhbmQgdW5kZXJzY29yZXMd</validators>
                        <help>Name of the field. The name is used to refer the field.</help>
                        <defaultValue/>
                      </field>
                      <field description="Type" name="type" type="S">
                        <selectionValues>
                          <option description="Integer">I</option>
                          <option description="String">S</option>
                          <option description="Boolean">B</option>
                          <option description="Long">L</option>
                          <option description="Float">F</option>
                          <option description="Double">E</option>
                          <option description="Date">D</option>
                          <option description="Data Table">T</option>
                          <option description="Color">C</option>
                          <option description="Data Block">A</option>
                        </selectionValues>
                        <help>Type of the field.</help>
                        <defaultValue>I</defaultValue>
                      </field>
                      <field description="Description" name="description" nullable="true" type="S">
                        <validators contentType="base64">HFIeW15ccHtDbnRybH1dKl5eRGVzY3JpcHRpb24gbWF5IGNvbnRhaW4gb25seSBwcmludGFibGUgY2hhcmFjdGVycx0=</validators>
                        <help>Textual field description.</help>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="Default" name="defaultValue" nullable="true" type="S">
                        <help>Default value of the field. You can omit this only if the field is nullable.</help>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="Read-only" name="readonly" type="B">
                        <help>Flag indicating that the values in this field are read-only. This applied to the UI-level editing and some data model level operations as well.</help>
                        <defaultValue>0</defaultValue>
                      </field>
                      <field description="Nullable" name="nullable" type="B">
                        <help>Flag indicating that field can contain NULL values.</help>
                        <defaultValue>0</defaultValue>
                      </field>
                      <field description="Key" name="key" type="B">
                        <help>Flag indicating that the field is a part of record’s unique ID, which is a unique combination of all key fields defined in the table format. Any declared key fields usually force the Data Table Smart Copy operation to employ a special copy algorithm that match records by their unique key field combinations rather than record numbers.</help>
                        <defaultValue>0</defaultValue>
                      </field>
                      <field description="Selection Values" name="selvals" type="T">
                        <help>List of values that can be selected for the field via a drop-down menu. A description must be defined for each value. Descriptions are shown when displaying the table to a user, and the values are available when the cell is referenced inside the platform.</help>
                        <defaultValue>
                          <table>
                            <format maxRecords="2147483647" reorderable="true">
                              <fields>
                                <field description="Value" keyfield="true" name="value" nullable="true" type="S">
                                  <defaultValue>
                                    <nullValue/>
                                  </defaultValue>
                                </field>
                                <field description="Description" name="description" type="S">
                                  <defaultValue/>
                                </field>
                              </fields>
                              <validators contentType="base64">HEseHQ==</validators>
                            </format>
                          </table>
                        </defaultValue>
                      </field>
                      <field description="Extendable Selection Values" name="extselvals" type="B">
                        <help>Flag indicating the field may be set to any value, including ones not listed in Selection Values.</help>
                        <defaultValue>0</defaultValue>
                      </field>
                      <field advanced="true" description="Hidden" name="hidden" type="B">
                        <help>The setting hides the field in the UI, but it remains accessible at the data model level.</help>
                        <defaultValue>0</defaultValue>
                      </field>
                      <field advanced="true" description="Inline" name="inline" type="B">
                        <help>&lt;p&gt;This flag has special meaning for different fields:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;If the Inline flag is set for a Data Block field, the field value will be stored in a dedicated database table. The value will not be initially loaded if the table itself is loaded from the database and sent to a AggreGate Client or external application. The Data Block value will, however, contain a data block ID that can be used to force loading the Data Block data from the server database. This is suitable for large binary values, such as image, sound, and video files.&lt;/li&gt;&lt;li&gt;If Inline flag is set for a Color field, field value will be used to highlight records of the table when its being viewed/edited in a Data Table Editor. Its often feasible to combine Inline flag with a Hidden flag to hide the Color field itself from the table. See the Row Coloring section below for more information.&lt;/li&gt;&lt;li&gt;If Inline flag is set for a Data Table field, default value of the field will have same format as format of the table to which the field belongs. This effectively enables creation of tables with unlimited nesting using Data Table Editor.&lt;/li&gt;&lt;/ul&gt;</help>
                        <defaultValue>0</defaultValue>
                      </field>
                      <field advanced="true" description="Encrypted" name="encrypted" type="B">
                        <help>Enables database-level field value encryption.</help>
                        <defaultValue>0</defaultValue>
                      </field>
                      <field description="Help" editor="textarea" name="help" nullable="true" type="S">
                        <validators contentType="base64">HFIeW15ccHtDbnRybH1dKl5eRGVzY3JpcHRpb24gbWF5IGNvbnRhaW4gb25seSBwcmludGFibGUgY2hhcmFjdGVycx0=</validators>
                        <help>Contents of the pop-up which is displayed to the user when hovering over a field.</help>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="Editor/Viewer" extendableSelectionValues="true" name="editor" nullable="true" type="S">
                        <selectionValues>
                          <option description="Default">
                            <nullValue/>
                          </option>
                          <option description="List">list</option>
                          <option description="Date">date</option>
                          <option description="Time">time</option>
                          <option description="Date/Time">dateTime</option>
                          <option description="Bar">bar</option>
                          <option description="Bytes">bytes</option>
                          <option description="Format Mask">formatString</option>
                          <option description="Class Instance">instance</option>
                          <option description="Time Period">period</option>
                          <option description="Foreign Class Instance">foreignInstance</option>
                          <option description="Expression">expression</option>
                          <option description="Function Selector">functionselector</option>
                          <option description="Password">password</option>
                          <option description="Text Editor">text</option>
                          <option description="HTML">html</option>
                          <option description="Text Area">textarea</option>
                          <option description="Hierarchical List">hierarchicalList</option>
                          <option description="Embedded Text Area">etextarea</option>
                          <option description="Context">context</option>
                          <option description="Context Mask">contextmask</option>
                          <option description="Font">font</option>
                          <option description="IP Address">ip</option>
                          <option description="Box">box</option>
                          <option description="Image">image</option>
                          <option description="Sound">sound</option>
                          <option description="Hex">hex</option>
                          <option description="Reference">reference</option>
                          <option description="Activator">activator</option>
                          <option description="Code Editor">code</option>
                          <option description="Spinner">spinner</option>
                          <option description="Event Level">eventLevel</option>
                          <option description="Date Range">dateRange</option>
                          <option description="Evaluation">evaluation</option>
                        </selectionValues>
                        <help>This parameter defines how the field is shown and modified in the user interface.</help>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="Editor Options" name="editorOptions" nullable="true" type="T">
                        <help>Editor/renderer options that allow fine-tuning rendering of field values in the UI.</help>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="Validators" name="validators" nullable="true" type="T">
                        <help>List of validators used to check if value is suitable for the field, as well as validator options. The platform features several pre-configured validators, internally used by the system to verify user input.</help>
                        <defaultValue>
                          <table>
                            <format maxRecords="2147483647" reorderable="true">
                              <fields>
                                <field description="Type" name="validator" nullable="true" type="S">
                                  <selectionValues>
                                    <option description="Default">
                                      <nullValue/>
                                    </option>
                                    <option description="ID">I</option>
                                    <option description="Limits">L</option>
                                    <option description="Non-Null">N</option>
                                    <option description="Regex">R</option>
                                    <option description="Expression">E</option>
                                  </selectionValues>
                                  <defaultValue>
                                    <nullValue/>
                                  </defaultValue>
                                </field>
                                <field description="Options" name="options" type="S">
                                  <defaultValue/>
                                </field>
                              </fields>
                            </format>
                          </table>
                        </defaultValue>
                      </field>
                      <field description="Group" name="group" nullable="true" type="S">
                        <help>A human-readable name of a field group. All fields that belong to the same group will appear together within the UI.</help>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                    </fields>
                    <bindings>
                      <binding>
                        <reference>editorOptions</reference>
                        <expression>callFunction(&quot;utilities&quot;, &quot;editorOptions&quot;, {type}, {editor}, {editorOptions})</expression>
                      </binding>
                      <binding>
                        <reference>editor#choices</reference>
                        <expression>{utilities:editors(&apos;{type}&apos;)}</expression>
                      </binding>
                    </bindings>
                    <validators contentType="base64">HEseHQ==</validators>
                  </format>
                </table>
              </defaultValue>
            </field>
            <field description="Reorderable" name="reorderable" type="B">
              <help>This flag indicates that records in this table may be swapped (re-ordered) during table processing.</help>
              <defaultValue>1</defaultValue>
            </field>
            <field description="Unresizable" name="unresizable" type="B">
              <help>This flag indicates that users cannot add or remove rows when editing the table.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Bindings" name="bindings" type="T">
              <help>A list of data bindings that define how the values in the table are changed when other table cells, or environment variables, are changed during table processing.</help>
              <defaultValue>
                <table>
                  <format maxRecords="2147483647" reorderable="true">
                    <fields>
                      <field description="Target" name="target" type="S">
                        <validators contentType="base64">HEweMSAyMTQ3NDgzNjQ3HQ==</validators>
                        <help>The binding&apos;s &lt;i&gt;Target&lt;/i&gt; field has the following syntax: &lt;b&gt;variable$field[row]#property&lt;/b&gt;. All elements of the binding target are optional, except for the &lt;b&gt;field&lt;/b&gt;. It indicates the field in the table to which changes should be applied.</help>
                        <defaultValue/>
                      </field>
                      <field description="Expression" editor="expression" name="expression" type="S">
                        <editorOptions contentType="base64"></editorOptions>
                        <validators contentType="base64">HEweMSAyMTQ3NDgzNjQ3HQ==</validators>
                        <help>The binding expression may contain only standard references. If a reference points to a cell within the table being edited, it will resolve to the value currently contained in the cell (which may be edited by a user, or written by other binding). In all other cases value will be retrieved from the server context, as described in standard references section.</help>
                        <defaultValue/>
                      </field>
                    </fields>
                  </format>
                </table>
              </defaultValue>
            </field>
            <field advanced="true" description="Encoded" editor="textarea" name="encoded" readonly="true" type="S">
              <help>Encoded table format</help>
              <defaultValue/>
            </field>
            <field description="Naming Expression" editor="expression" name="namingExpression" nullable="true" type="S">
              <editorOptions contentType="base64"></editorOptions>
              <help>An Expression that defines how the table is presented to the users in the interface. It must return a string that will be user as the table&apos;s description.</help>
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
          </fields>
          <validators contentType="base64">HEUeZTIxcGJsSmxZMjl5WkhOOUlEdzlJSHR0WVhoU1pXTnZjbVJ6ZlNBL0lHNTFiR3dnT2lBblZHaGxJRzFoZUdsdGRXMGdiblZ0WW1WeUlHOW1JSEpsWTI5eVpITWdZMkZ1Ym05MElHSmxJR3h2ZDJWeUlIUm9ZVzRnZEdobElHMXBibWx0ZFcwbh0=</validators>
        </format>
      </entry>
