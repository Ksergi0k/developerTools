  <formats>
    <formats class="linked-hash-map">
      <entry>
        <int>0</int>
        <format maxRecords="1" minRecords="1">
          <fields>
            <field description="Name" name="name" notReplicated="true" type="S">
              <validators contentType="base64">HEkeHRxMHjEgNTAdHFIeXHcrXl5OYW1lIG1heSBjb250YWluIG9ubHkgTGF0aW4gbGV0dGVycywgZGlnaXRzLCBhbmQgdW5kZXJzY29yZXMd</validators>
              <help>Name of the resource and corresponding system context, required to refer to this resource from other parts of the system. It should satisfy the context naming conventions. WARNING: changing name will corrupt all references to the resource.</help>
              <defaultValue/>
            </field>
            <field description="Description" name="description" notReplicated="true" type="S">
              <validators contentType="base64">HEweMCAxMDAdHFIeW15ccHtDbnRybH1dKl5eRGVzY3JpcHRpb24gbWF5IGNvbnRhaW4gb25seSBwcmludGFibGUgY2hhcmFjdGVycx0=</validators>
              <help>This field defines a dashboard textual description. This is also a description of the Dashboard context.</help>
              <defaultValue/>
            </field>
            <field description="Title Expression" editor="expression" name="title" type="S">
              <editorOptions contentType="base64"></editorOptions>
              <help>This field defines a dashboard title appearing on the top of the dashboard window. If the title is not specified, its description is used instead. The title can be a plain string or an expression. If it&apos;s an expression, it returns a string to allow the relative dashboard titles displaying values from the contexts whose data is shown on the dashboard.</help>
              <group>Window Properties</group>
              <defaultValue/>
            </field>
            <field description="Layout" name="layout" type="I">
              <help>The field allows to specify the dashboard layout: dockable or scrollable.</help>
              <group>Window Properties</group>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Column Count" name="columns" type="I">
              <help>The field defines a number of columns. The option is relevant to scrollable dashboards only.</help>
              <group>Window Properties</group>
              <defaultValue>3</defaultValue>
            </field>
            <field advanced="true" description="Destination" name="destination" readonly="true" type="I">
              <selectionValues>
                <option description="Web">0</option>
                <option description="Desktop">1</option>
              </selectionValues>
              <help>The field defines the dashboard destination: Web or Desktop.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Type" name="type" type="I">
              <selectionValues>
                <option description="Relative">0</option>
                <option description="Absolute">1</option>
                <option description="Class Instance">2</option>
              </selectionValues>
              <help>The field defines the dashboard type: Absolute or Relative.</help>
              <defaultValue>1</defaultValue>
            </field>
            <field description="Printable" name="printable" type="B">
              <help>Dashboard type for creating printable reports</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Validity Expression" editor="expression" name="validityExpression" type="S">
              <editorOptions contentType="base64"></editorOptions>
              <help>The field includes the expression defining context(s) to which the dashboard can be attached.</help>
              <group>Validity</group>
              <defaultValue/>
            </field>
            <field description="Validity Update Rules" name="validityListeners" type="T">
              <help>This field defines a list of context masks and event names. If the event specified in the Event field occurs in any of contexts matching the mask specified by the Mask field in the same record, the Validity Expression will be recalculated for this context. This allows to make the dashboard valid/invalid for a certain context if some changes occur in it.</help>
              <group>Validity</group>
              <defaultValue>
                <table>
                  <format maxRecords="2147483647">
                    <fields>
                      <field description="Context Mask" editor="contextmask" icon="fi_context" keyfield="true" name="mask" type="S">
                        <help>Mask of contexts to monitor events in</help>
                        <defaultValue/>
                      </field>
                      <field description="Event" extendableSelectionValues="true" icon="fi_event" keyfield="true" name="event" type="S">
                        <help>Name of Event to listen for</help>
                        <defaultValue/>
                      </field>
                      <field description="Target Expression" editor="expression" icon="fi_expression" name="expression" nullable="true" type="S">
                        <editorOptions contentType="base64"></editorOptions>
                        <help>If specified, points to a context those validity should be checked. If Target Expression is not specified (what is suitable in most cases), the system checks validity of context in that Event has occurred.</help>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                    </fields>
                    <bindings>
                      <binding>
                        <reference>event#choices</reference>
                        <expression>{utilities:eventsByMask(&apos;{mask}&apos;)}</expression>
                      </binding>
                    </bindings>
                    <validators contentType="base64">HEseHQ==</validators>
                  </format>
                </table>
              </defaultValue>
            </field>
            <field advanced="true" description="Generate Attached and Detached Events" name="generateAttachedEvents" type="B">
              <help>Attached and Detached events to be generated after attaching to a context</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Allow Validity For Remote Contexts" name="allowValidityForRemoteContexts" type="B">
              <help>If enabled then this context will be allowed to attach to remote contexts, connected via distributed architecture</help>
              <group>Validity</group>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Default Context" editor="context" name="defaultContext" nullable="true" type="S">
              <group>Validity</group>
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
            <field description="Closable" name="closable" type="B">
              <help>This flag defines whether the dashboard can be closed. Non-closable dashboards often play a role of main dashboards in operator UIs.</help>
              <group>Additional Properties</group>
              <defaultValue>1</defaultValue>
            </field>
            <field description="Close Dashboard On Reopen" name="closeDashboardOnReopen" type="B">
              <group>Additional Properties</group>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Launch as Default Action" name="launchAsDefault" type="B">
              <help>Defines whether the relative dashboard will open as the default action of contexts it&apos;s attached to.</help>
              <group>Additional Properties</group>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Layout Control Panel" name="layoutControlPanel" type="B">
              <help>This flag defines the visibility of the bottom panel (Save/Load layout and other buttons).</help>
              <group>Additional Properties</group>
              <defaultValue>1</defaultValue>
            </field>
            <field description="Template Processing Expression" editor="expression" name="templateProcessingExpression" nullable="true" type="S">
              <editorOptions contentType="base64"></editorOptions>
              <help>If specified, it processes the template during dashboard opening and return the modified template</help>
              <group>Additional Properties</group>
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
            <field description="Template" editor="context" name="template" nullable="true" type="S">
              <editorOptions contentType="base64"></editorOptions>
              <help>Dashboard context to be used as template</help>
              <group>Additional Properties</group>
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
            <field description="Storage Context" editor="context" name="storageContext" type="S">
              <defaultValue/>
            </field>
            <field description="Table" name="storageClass" type="S">
              <defaultValue/>
            </field>
            <field hidden="true" name="resourceBundle" nullable="true" readonly="true" type="S">
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
            <field advanced="true" description="Enable Caching" name="cacheEnabled" type="B">
              <help>Enables caching of this dashboard for better performance. Once a hidden and cached dashboard is displayed again, its startup bindings are not re-evaluated. Cached dashboards also keep user input (e.g. values in text fields) that were not yet transferred to server&apos;s unified data model. This option will only have effect if caching is enabled in Web UI plugin global configuration.</help>
              <defaultValue>1</defaultValue>
            </field>
            <field advanced="true" description="Header Expression" editor="expression" name="headerExpression" nullable="true" type="S">
              <editorOptions contentType="base64"></editorOptions>
              <help>This expression is evaluated during dashboard startup. It accepts dashboard&apos;s element table as the default table. The returned string is set as the dashboard’s header.</help>
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
            <field advanced="true" description="Log Bindings Execution" name="logBindingsExecution" type="B">
              <editorOptions contentType="base64"></editorOptions>
              <help>This option enables and disables the logging of all executed bindings.</help>
              <defaultValue>0</defaultValue>
            </field>
          </fields>
          <bindings>
            <binding>
              <reference>layout#choices</reference>
              <expression>{utilities:layoutsByDestination(&apos;{destination}&apos;)}</expression>
            </binding>
            <binding>
              <reference>columns#hidden</reference>
              <expression>{layout} != 1</expression>
            </binding>
            <binding>
              <reference>validityExpression#hidden</reference>
              <expression>{type} != 0</expression>
            </binding>
            <binding>
              <reference>validityListeners#hidden</reference>
              <expression>{type} != 0</expression>
            </binding>
            <binding>
              <reference>generateAttachedEvents#hidden</reference>
              <expression>{type} != 0</expression>
            </binding>
            <binding>
              <reference>allowValidityForRemoteContexts#hidden</reference>
              <expression>{type} != 0</expression>
            </binding>
            <binding>
              <reference>defaultContext#hidden</reference>
              <expression>{type} != 0</expression>
            </binding>
            <binding>
              <reference>storageContext#hidden</reference>
              <expression>{type} != 2</expression>
            </binding>
            <binding>
              <reference>storageClass#hidden</reference>
              <expression>{type} != 2</expression>
            </binding>
            <binding>
              <reference>storageClass#enabled</reference>
              <expression>{storageContext} != null &amp;&amp; length({storageContext}) &gt; 0 &amp;&amp; functionAvailable({storageContext}, &apos;storageTables&apos;)</expression>
            </binding>
            <binding>
              <reference>storageClass#choices</reference>
              <expression>({storageContext} != null &amp;&amp; length({storageContext}) &gt; 0) ? callFunction(&quot;utilities&quot;, &quot;selectionValues&quot;, &quot;callFunction(&apos;&quot; + {storageContext} + &quot;&apos;, &apos;storageTables&apos;)&quot;,  &quot;{value}&quot;,  &quot;{description}&quot;) : null</expression>
            </binding>
            <binding>
              <reference>title#hidden</reference>
              <expression>{destination} == 0</expression>
            </binding>
            <binding>
              <reference>closable#hidden</reference>
              <expression>{destination} == 0</expression>
            </binding>
            <binding>
              <reference>closeDashboardOnReopen#hidden</reference>
              <expression>{destination} == 0</expression>
            </binding>
            <binding>
              <reference>layoutControlPanel#hidden</reference>
              <expression>{destination} == 0</expression>
            </binding>
            <binding>
              <reference>templateProcessingExpression#hidden</reference>
              <expression>{destination} != 0</expression>
            </binding>
            <binding>
              <reference>templateProcessingExpression#options</reference>
              <expression>variableAvailable({.:}, &apos;elements&apos;) ? encode(table(&apos;&lt;&lt;context&gt;&lt;S&gt;&lt;F=N&gt;&lt;A=&lt;NULL&gt;&gt;&lt;D=Default Context&gt;&gt;&lt;&lt;table&gt;&lt;T&gt;&lt;F=N&gt;&lt;A=&lt;NULL&gt;&gt;&lt;D=Default Table&gt;&gt;&lt;&lt;references&gt;&lt;T&gt;&lt;F=N&gt;&lt;A=&lt;F=&lt;&lt;reference&gt;&lt;S&gt;&lt;A=&gt;&lt;D=Reference &gt;&gt;&lt;&lt;description&gt;&lt;S&gt;&lt;A=&gt;&lt;D=Description&gt;&gt;&gt;&gt;&lt;D=References&gt;&gt;&lt;&lt;expectedResult&gt;&lt;S&gt;&lt;F=N&gt;&lt;A=&lt;NULL&gt;&gt;&lt;D=Expected Result&gt;&gt;&lt;&lt;permissionsDescription&gt;&lt;S&gt;&lt;F=N&gt;&lt;A=&lt;NULL&gt;&gt;&lt;D=Permissions&gt;&gt;&lt;&lt;contextDescription&gt;&lt;S&gt;&lt;F=N&gt;&lt;A=&lt;NULL&gt;&gt;&lt;D=Default Context Description&gt;&gt;&lt;&lt;tableDescription&gt;&lt;S&gt;&lt;F=N&gt;&lt;A=&lt;NULL&gt;&gt;&lt;D=Default Table Description&gt;&gt;&lt;&lt;rowDescription&gt;&lt;S&gt;&lt;F=N&gt;&lt;A=&lt;NULL&gt;&gt;&lt;D=Default Row Description&gt;&gt;&lt;&lt;type&gt;&lt;I&gt;&lt;F=H&gt;&lt;A=0&gt;&lt;D=Type&gt;&lt;S=&lt;General=0&gt;&lt;Condition=1&gt;&gt;&gt;&lt;&lt;environmentVariables&gt;&lt;T&gt;&lt;F=N&gt;&lt;A=&lt;F=&lt;&lt;variable&gt;&lt;S&gt;&lt;A=&gt;&lt;D=Variable&gt;&gt;&lt;&lt;description&gt;&lt;S&gt;&lt;A=&gt;&lt;D=Description&gt;&gt;&gt;&gt;&lt;D=Environment Variables&gt;&gt;&lt;M=1&gt;&lt;X=1&gt;&apos;, {.:}, {.:elements}))  : &apos;&apos;</expression>
            </binding>
            <binding>
              <reference>cacheEnabled#hidden</reference>
              <expression>{destination} != 0</expression>
            </binding>
            <binding>
              <reference>template#hidden</reference>
              <expression>{destination} != 0</expression>
            </binding>
            <binding>
              <reference>layout#hidden</reference>
              <expression>{destination} == 0</expression>
            </binding>
          </bindings>
        </format>
      </entry>
      <entry>
        <int>1</int>
        <format maxRecords="2147483647">
          <fields>
            <field description="Name" name="name" type="S">
              <help>Indicates HTTP header name.</help>
              <defaultValue/>
            </field>
            <field description="Value Expression" editor="expression" name="valueExpression" type="S">
              <editorOptions contentType="base64"></editorOptions>
              <help>An expression that must evaluate to a string, which is processed as the HTTP header value. The expression is evaluated at the moment the dashboard is opened.</help>
              <defaultValue/>
            </field>
          </fields>
        </format>
      </entry>
      <entry>
        <int>2</int>
        <format maxRecords="2147483647">
          <fields>
            <field description="Component" name="component" type="S">
              <defaultValue/>
            </field>
            <field description="Variables" name="variables" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647">
                    <fields>
                      <field description="Name" name="name" type="S">
                        <defaultValue/>
                      </field>
                      <field description="Value" name="value" type="T">
                        <defaultValue>
                          <table>
                            <format maxRecords="2147483647"/>
                          </table>
                        </defaultValue>
                      </field>
                      <field description="Username" name="user" nullable="true" type="S">
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                    </fields>
                  </format>
                </table>
              </defaultValue>
            </field>
          </fields>
        </format>
      </entry>
      <entry>
        <int>3</int>
        <format maxRecords="2147483647">
          <fields>
            <field description="ID" name="id" type="S">
              <defaultValue/>
            </field>
            <field description="Username" name="user" nullable="true" type="S">
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
            <field description="Layout Data" name="layoutData" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647">
                    <fields>
                      <field description="ID" name="id" type="S">
                        <help>If this element was previously docked, this is the ID of the panel it was docked to before it became a floating element.</help>
                        <defaultValue/>
                      </field>
                      <field description="Parent ID" name="parentId" nullable="true" type="S">
                        <help>ID of the parent element.</help>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="Order ID" name="orderId" type="I">
                        <help>Order of the element within its parent container.</help>
                        <defaultValue>0</defaultValue>
                      </field>
                      <field description="Mode" name="mode" nullable="true" type="S">
                        <help>Mode of the element (e.g., &apos;dock&apos;, &apos;float&apos;).</help>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="Size" name="size" type="I">
                        <help>Size of the element.</help>
                        <defaultValue>0</defaultValue>
                      </field>
                      <field description="X" name="x" nullable="true" type="E">
                        <help>X-coordinate of the element (for floating elements).</help>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="Y" name="y" nullable="true" type="E">
                        <help>Y-coordinate of the element (for floating elements).</help>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="Z" name="z" nullable="true" type="I">
                        <help>Z-index of the element (for floating elements). Elements with a larger Z-index will obscure elements with a lower Z-index.</help>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="H" name="h" nullable="true" type="I">
                        <help>Height of the element (for floating elements).</help>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="W" name="w" nullable="true" type="I">
                        <help>Width of the element (for floating elements).</help>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="Dock Location Parent ID" name="dockLocationParentId" type="S">
                        <defaultValue/>
                      </field>
                      <field description="Dock Location Tab Index" name="dockLocationTabIndex" type="I">
                        <help>If this element was previously docked as a tab, this is its index within the parent tab container before it became a floating element.</help>
                        <defaultValue>0</defaultValue>
                      </field>
                      <field description="Dock Location Panel Index" name="dockLocationPanelIndex" type="I">
                        <help>If this element was previously docked as a panel, this is its index within the parent panel container before it became a floating element.</help>
                        <defaultValue>0</defaultValue>
                      </field>
                    </fields>
                  </format>
                </table>
              </defaultValue>
            </field>
            <field name="children" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647">
                    <fields>
                      <field name="componentId" type="S">
                        <defaultValue/>
                      </field>
                      <field description="Tab ID" name="tabId" type="S">
                        <help>Dockable tab identifier, which by default is the dockable component name.</help>
                        <defaultValue/>
                      </field>
                      <field description="Panel ID" name="panelId" type="S">
                        <help>Identified of the panel the dockable component is located in.</help>
                        <defaultValue/>
                      </field>
                      <field description="Order ID" name="orderId" type="I">
                        <help>Index of tab the dockable component will occupy in a tabbed panel. Indexed from zero, where 0 is the first tab, 1 is the second tab, and so on.</help>
                        <defaultValue>0</defaultValue>
                      </field>
                      <field description="Active" name="active" type="B">
                        <help>Indicates that the dockable component is the selected tab, in the case that the component is in a tabbed panel.</help>
                        <defaultValue>0</defaultValue>
                      </field>
                    </fields>
                  </format>
                </table>
              </defaultValue>
            </field>
          </fields>
        </format>
      </entry>
      <entry>
        <int>4</int>
        <format maxRecords="2147483647" reorderable="true">
          <fields>
            <field description="Name" keyfield="true" name="name" type="S">
              <help>Name of the resource and corresponding system context, required to refer to this resource from other parts of the system. It should satisfy the context naming conventions. WARNING: changing name will corrupt all references to the resource.</help>
              <defaultValue/>
            </field>
            <field description="Type" extendableSelectionValues="true" name="type" type="S">
              <selectionValues>
                <option description="Root">root</option>
                <option description="Simple Panel">panel</option>
                <option description="Tab Panel">tabbedPanel</option>
                <option description="Carousel">carousel</option>
                <option description="Steps Panel">steps</option>
                <option description="Steps Content">stepsContent</option>
                <option description="Sub-dashboard">subdashboard</option>
                <option description="Implant">implant</option>
                <option description="Drawer Panel">drawerPanel</option>
                <option description="HTML Snippet">htmlSnippet</option>
                <option description="Label">label</option>
                <option description="Image">image</option>
                <option description="Tree">customTree</option>
                <option description="System Tree">systemTree</option>
                <option description="Progress Bar">progressBar</option>
                <option description="Tab">tab</option>
                <option description="Data Table">dataTableEditor</option>
                <option description="Spreadsheet">spreadsheet</option>
                <option description="Data Table Header">dataTableEditorHeader</option>
                <option description="Timer">timer</option>
                <option description="Class Data Table">classDataTableEditor</option>
                <option description="Class Field List">classFieldList</option>
                <option description="Event Log">eventLog</option>
                <option description="Vector Drawing">vectorDrawing</option>
                <option description="Slider">slider</option>
                <option description="Context List">contextList</option>
                <option description="Connector">connector</option>
                <option description="Text Field">textField</option>
                <option description="Text Area">textArea</option>
                <option description="Dropdown Menu">dropDownButton</option>
                <option description="Button">button</option>
                <option description="Dropdown List">dropdownList</option>
                <option description="Check Box">checkBox</option>
                <option description="Check Box Group">checkBoxGroup</option>
                <option description="Toggle Button">toggleButton</option>
                <option description="Radio Button Group">radioButton</option>
                <option description="Date Time Picker">dateTimePicker</option>
                <option description="Button Group">buttonGroup</option>
                <option description="Dropdown Tree">treeSelect</option>
                <option description="Number Field">numberField</option>
                <option description="Time Picker">timePicker</option>
                <option description="Uploader">uploader</option>
                <option description="Map">map</option>
                <option description="Breadcrumbs">breadcrumb</option>
                <option description="Menu">menu</option>
                <option description="Gantt Chart">ganttChart</option>
                <option description="Bubble Chart">bubbleChart</option>
                <option description="Bar Chart">barChart</option>
                <option description="Candlestick Chart">candlestickChart</option>
                <option description="Interval Bar Chart">intervalBarChart</option>
                <option description="Line Chart">lineChart</option>
                <option description="Statistical Chart">statisticalChart</option>
                <option description="Deviation Chart">deviationChart</option>
                <option description="Interval Chart">intervalChart</option>
                <option description="Area Chart">areaChart</option>
                <option description="Pie Chart">pieChart</option>
                <option description="Spider Chart">spiderChart</option>
                <option description="Polar Chart">polarChart</option>
                <option description="Gauge">gauge</option>
                <option description="Linear Gauge">linearGauge</option>
                <option description="Liquid Gauge">liquidGauge</option>
                <option description="Graph">graph</option>
              </selectionValues>
              <help>This field defines the element type.</help>
              <defaultValue>root</defaultValue>
            </field>
            <field description="Parameters" name="parameters" type="T">
              <help>This field defines the element settings. The settings define which data to show and how to present it. The list of settings depends on the element type.</help>
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
          </fields>
          <bindings>
            <binding>
              <reference>parameters</reference>
              <expression>{.:elementParameters(&apos;{type}&apos;, &apos;{parameters}&apos;)}</expression>
            </binding>
          </bindings>
          <validators contentType="base64">HEseHQ==</validators>
        </format>
      </entry>
      <entry>
        <int>5</int>
        <format maxRecords="1" minRecords="1">
          <fields>
            <field description="All Bindings" name="bindings" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Startup Bindings Concurrency" name="startupBindingsConcurrency" type="B">
              <help>If enabled, multiple threads will concurrently process all startup bindings. If disabled, all startup bindings are processed sequentially.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Normal Concurrent Bindings" extendableSelectionValues="true" name="normalConcurrentBindings" type="I">
              <selectionValues>
                <option description="Disabled">0</option>
              </selectionValues>
              <help>The maximum number of binding processing tasks under normal circumstances. If more than this number of tasks should start execution, further tasks are getting queued for later execution once execution threads get free.</help>
              <defaultValue>5</defaultValue>
            </field>
            <field description="Maximum Concurrent Bindings" extendableSelectionValues="true" name="maximumConcurrentBindings" type="I">
              <selectionValues>
                <option description="Disabled">0</option>
              </selectionValues>
              <help>The absolute maximum number of threads in a binding processing pool. If this maximum number is reached and there are even more tasks to be executed right now, their execution will either fail or block until the pool gets some free resources.</help>
              <defaultValue>100</defaultValue>
            </field>
            <field description="Maximum Unprocessed Binding Queue Length" name="maximumBindingQueueLength" type="I">
              <help>The maximum number of binding processing tasks that can get queued. If the queue gets full, additional binding processing threads will be created in the pool until the Maximum Concurrent Bindings limit is reached.</help>
              <defaultValue>1000</defaultValue>
            </field>
            <field description="Background Image" name="backgroundImage" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Variables Storage" name="variablesStorage" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Context Menu" name="contextMenu" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Show Header" name="showHeader" type="B">
              <help>Configures whether the dockable window header should be displayed.</help>
              <defaultValue>1</defaultValue>
            </field>
            <field description="Description" name="description" type="S">
              <help>Dockable window header text.</help>
              <defaultValue/>
            </field>
            <field description="Icon" name="icon" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Maximizable" name="maximizable" type="B">
              <help>Configures whether the dockable window can be maximized.</help>
              <defaultValue>1</defaultValue>
            </field>
            <field description="Collapsible" name="collapsible" type="B">
              <help>Configures whether the dockable window can be collapsed.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Movable" name="dockMovable" type="B">
              <help>Configures whether the dockable window can be moved.</help>
              <defaultValue>1</defaultValue>
            </field>
            <field description="Collapsed" name="dockCollapsed" type="B">
              <help>Configures whether the dockable window is collapsed.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Floatable" name="dockFloatable" type="B">
              <help>Configures whether the dockable window can be floated.</help>
              <defaultValue>1</defaultValue>
            </field>
            <field description="Resizable" name="dockResizable" type="B">
              <help>Configures whether the dockable window can be resized.</help>
              <defaultValue>1</defaultValue>
            </field>
            <field description="Tab Position" name="dockTabPosition" type="S">
              <selectionValues>
                <option description="Top">top</option>
                <option description="Bottom">bottom</option>
                <option description="Left">left</option>
                <option description="Right">right</option>
              </selectionValues>
              <help>Configures the position of tabs appearing when the dockable window is stacked into a tabbed panel with other windows.</help>
              <defaultValue>top</defaultValue>
            </field>
            <field description="Preferred Width" name="dockPreferredWidth" type="I">
              <help>Desired width of the dockable window when split into another component or a dashboard.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Preferred Height" name="dockPreferredHeight" type="I">
              <help>Desired height of the dockable window when split into another component or a dashboard.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Minimum Width" name="dockMinimumWidth" type="I">
              <help>Minimum width of the dockable window when split into another component or a dashboard. Overridden when the viewscreen does not have sufficient space for the minimum width.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Minimum Height" name="dockMinimumHeight" type="I">
              <help>Minimum height of the dockable window when split into another component or a dashboard. Overridden when the viewscreen does not have sufficient space for the minimum height.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Custom Classes" name="customClasses" type="S">
              <help>Custom CSS classes that may be used in the CSS style related properties.</help>
              <defaultValue/>
            </field>
            <field description="Component Content Style" editor="code" name="style" nullable="true" type="S">
              <editorOptions>scss</editorOptions>
              <help>CSS Style to be applied to the component.</help>
              <defaultValue/>
            </field>
            <field description="Visible Children" name="visibleChildren" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Visible" name="preloaderVisible" type="B">
              <help>Toggles whether the preloader is displayed. When true, the entire component will be hidden behind the preloader during the loading phase.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Class Name" name="preloaderClass" type="S">
              <help>CSS class name to add to the preloader image and text.</help>
              <defaultValue/>
            </field>
            <field description="Text" name="preloaderText" type="S">
              <help>Text to display in the preloader.</help>
              <defaultValue/>
            </field>
            <field description="Icon" name="preloaderIcon" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Generate Mouse Clicked Events" name="generateMouseClicked" type="B">
              <help>Controls whether the component generated Mouse Clicked events. Initially disabled for performance reasons.</help>
              <defaultValue>1</defaultValue>
            </field>
            <field description="Generate Mouse Double Clicked Events" name="generateMouseDoubleClicked" type="B">
              <help>Controls whether the component generated Mouse Double events. Initially disabled for performance reasons.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Generate Mouse Pressed Events" name="generateMousePressed" type="B">
              <help>Controls whether the component generated Mouse Pressed events. Initially disabled for performance reasons.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Generate Mouse Released Events" name="generateMouseReleased" type="B">
              <help>Controls whether the component generated Mouse Released events. Initially disabled for performance reasons.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Generate Mouse Entered Events" name="generateMouseEntered" type="B">
              <help>Controls whether the component generated Mouse Entered events. Initially disabled for performance reasons.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Generate Mouse Exited Events" name="generateMouseExited" type="B">
              <help>Controls whether the component generated Mouse Exited events. Initially disabled for performance reasons.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="childContexts" name="childContexts" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Editable" name="editable" type="B">
              <defaultValue>1</defaultValue>
            </field>
            <field description="Enable Dynamic Contents" name="dynamicContentsEnabled" type="B">
              <help>Controls runtime creation of contents within the container. A container with dynamic contents must contain exactly one child component (or a single child hierarchy of components with a container-type root component). This component/hierarchy will be replicated for each row in the Dynamic Contents table, effectively adding new children to the container.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Static Format" name="dynamicContentsUseStaticFormat" type="B">
              <help>When true, the Format property will define the format of the Dynamic Contents data table. This also allows putting a &quot;static&quot; dataset into the Dynamic Contents table via the component properties editor.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Format" name="dynamicContentsFormat" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Dynamic Contents" name="dynamicContentsSource" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Component Name Suffix Expression" editor="expression" name="dynamicContentsSuffix" type="S">
              <help>An expression used to generate custom suffixes for the names of dynamically created components based on the current row of the Dynamic Contents dataset. If not specified, the contexts are named according to &lt;originalComponentName&gt;{#row} pattern: if a name of the dynamic container&apos;s component being replicated is &quot;template&quot; its clones will be named &quot;template1&quot;, &quot;template2&quot;, etc.</help>
              <defaultValue/>
            </field>
            <field description="Positioning" name="dynamicContentsPositioning" type="S">
              <selectionValues>
                <option description="Automatic">AUTOMATIC</option>
                <option description="Manual">MANUAL</option>
              </selectionValues>
              <help>When &apos;Automatic&apos; is selected, the created components will be positioned next to each other according to the current container&apos;s layout, and with &apos;Manual&apos; their constraints must be set with bindings.</help>
              <defaultValue>AUTOMATIC</defaultValue>
            </field>
            <field description="Current Page Offset" name="currentPageOffset" type="I">
              <defaultValue>0</defaultValue>
            </field>
            <field description="Items Total Count" name="totalCount" type="I">
              <defaultValue>0</defaultValue>
            </field>
            <field description="Items Per Page" name="pageSize" type="I">
              <validators contentType="base64">HEweMSAyMTQ3NDgzNjQ3HQ==</validators>
              <help>Number of dynamically created components (or component hierarchies) to display per page. If the number of dynamically created components exceeds this number, a paginator appears in the container, otherwise the components are displayed without pagination. Each page contains a unique set of components.</help>
              <defaultValue>10</defaultValue>
            </field>
            <field description="Show &apos;Items per Page&apos; Selector" name="showPageSizeSelector" type="B">
              <help>Gives the user an option to select the number of items to display per page, with selection values taken from Custom ‘Items Per Page’ Selection Values.</help>
              <defaultValue>1</defaultValue>
            </field>
            <field description="&apos;Items per Page&apos; Selector Type" name="pageSizeSelectorType" type="S">
              <selectionValues>
                <option description="Combo Box">combobox</option>
                <option description="Button Group">button-group</option>
              </selectionValues>
              <help>Indicates what kind of selector to display to the user, allowing them to select the number of items to display per page.</help>
              <defaultValue>combobox</defaultValue>
            </field>
            <field description="Custom &apos;Items per Page&apos; Selection Values" name="pageSizeOptions" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Layout" name="layout" type="S">
              <selectionValues>
                <option description="Grid">grid</option>
                <option description="Absolute">absolute</option>
                <option description="Dockable">dockable</option>
              </selectionValues>
              <help>&lt;p&gt;Defines container layout type:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Grid layout&lt;/b&gt; is a matrix of rows and columns, allowing certain components to span multiple rows or columns. Rows can have different heights. Similarly, columns may have different widths. The grid may be shown or hidden when editing the dashboard in the UI Builder, but is never shown when the dashboard is running. Only the actual components are visible. Grid layout is backed by and rendered with &lt;i&gt;CSS Grid&lt;/i&gt; technology.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Absolute layout&lt;/b&gt; defines constraints for each component by their pixel coordinates and size on the canvas. This may be very convenient for designing human-machine interfaces (HMIs), facility/floor plans, and other similar UIs. Components are moved, aligned and sized by dragging and dropping on the canvas, and can even overlap one another.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Dockable layout&lt;/b&gt; empowers interface designers to craft flexible and customizable user interfaces by distributing components as floating windows, horizontally or vertically-aligned panes, or tabs within panes. The dashboard developer designs the initial layout of a dockable container and the extent it can be customized by the user, for example, whether windows can be closed or set as floating. End users are able to reorganize or minimize windows to create personalized layouts that suit their preferences. To edit a dockable layout, users and designers click and hold a window to open the layout selector. A menu will pop up, indicating the orientation of the window when dropped in a certain position.&lt;/li&gt;&lt;/ul&gt;</help>
              <defaultValue>grid</defaultValue>
            </field>
            <field description="Gap" name="gap" type="S">
              <help>Defines cell grid line width, in pixels.</help>
              <defaultValue>10px</defaultValue>
            </field>
            <field description="Grid Column Properties" name="gridCols" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Grid Row Properties" name="gridRows" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Resizable" hidden="true" name="resizable" type="B">
              <defaultValue>1</defaultValue>
            </field>
            <field description="Movable" hidden="true" name="movable" type="B">
              <defaultValue>1</defaultValue>
            </field>
            <field description="Max columns" hidden="true" name="maxColumns" type="I">
              <defaultValue>12</defaultValue>
            </field>
            <field description="Max Rows" hidden="true" name="maxRows" type="I">
              <defaultValue>2</defaultValue>
            </field>
            <field description="Grid Type" name="gridType" type="S">
              <selectionValues>
                <option description="Scrollable">scrollable</option>
                <option description="Non-scrollable">dockable</option>
              </selectionValues>
              <defaultValue>dockable</defaultValue>
            </field>
            <field description="Show Grid Background" name="showGridBackground" type="S">
              <selectionValues>
                <option description="None">none</option>
                <option description="Rows">rows</option>
                <option description="Columns">columns</option>
                <option description="Rows And Columns">rowsAndColumns</option>
              </selectionValues>
              <defaultValue>rowsAndColumns</defaultValue>
            </field>
            <field description="Snap to Grid" name="snapToGrid" type="B">
              <help>Available in containers configured with Absolute layout. When enabled, overlays a snap-to grid on the canvas. This grid is invisible and non-functional during normal dashboard operation. During dashboard editing, components will automatically be aligned with the nearest horizontal and vertical lines of the snap-to grid. The cell size of the snap-to grid is determined by the Grid Step property.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Dock Layout Structure" name="dockLayoutStructure" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Layout Storage" name="layoutStorage" type="S">
              <selectionValues>
                <option description="Shared">shared</option>
                <option description="For Every User">forEveryUser</option>
                <option description="For Every Login">forEveryLogin</option>
                <option description="Do Not Store">doNotStore</option>
              </selectionValues>
              <help>&lt;p&gt;Determines how dockable layouts should be persisted between users and user sessions:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Shared:&lt;/b&gt; The layout will be shared between users. If one user makes a change to the layout, this will be applied to all users.&lt;/li&gt;&lt;li&gt;&lt;b&gt;For Every User:&lt;/b&gt; Each user will have their own layout saved, which will persist between sessions.&lt;/li&gt;&lt;li&gt;&lt;b&gt;For Every Login:&lt;/b&gt; The dockable layout will be persisted during a single session, but when the user logs out, the layout will return to the default.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Do Not Store:&lt;/b&gt; The layout will revert to its default each time the user navigates away from the dashboard.&lt;/li&gt;&lt;/ul&gt;</help>
              <defaultValue>shared</defaultValue>
            </field>
            <field description="Grid Step" name="gridStep" type="S">
              <help>Applicable when the Snap to Grid property is enabled. Indicates the number of pixels between each column and row of the snap-to grid.</help>
              <defaultValue>10</defaultValue>
            </field>
            <field description="Band Type" name="bandType" nullable="true" type="S">
              <help>Functional purpose and place of the band in the report generation life cycle</help>
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
            <field description="Layout Width" name="layoutWidth" type="I">
              <help>Layout width for absolute layout, in pixels.</help>
              <defaultValue>800</defaultValue>
            </field>
            <field description="Layout Height" name="layoutHeight" type="I">
              <help>Layout height for absolute layout, in pixels.</help>
              <defaultValue>800</defaultValue>
            </field>
            <field description="Left Margin" name="marginLeft" type="I">
              <help>Left Margin</help>
              <defaultValue>30</defaultValue>
            </field>
            <field description="Right Margin" name="marginRight" type="I">
              <help>Right Margin</help>
              <defaultValue>30</defaultValue>
            </field>
            <field description="Top Margin" name="marginTop" type="I">
              <help>Top Margin</help>
              <defaultValue>40</defaultValue>
            </field>
            <field description="Bottom Margin" name="marginBottom" type="I">
              <help>Bottom Margin</help>
              <defaultValue>40</defaultValue>
            </field>
            <field description="Breakpoints" name="breakpoints" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Current Breakpoint" name="currentBreakpoint" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Default Screen Resolution" name="defaultBreakpoint" type="S">
              <defaultValue>none</defaultValue>
            </field>
            <field description="Custom Properties" name="customProperties" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="state" name="state" type="S">
              <selectionValues>
                <option description="CREATED">CREATED</option>
                <option description="STARTING">STARTING</option>
                <option description="RUNNING">RUNNING</option>
                <option description="PAUSED">PAUSED</option>
                <option description="STOPPED">STOPPED</option>
              </selectionValues>
              <defaultValue>CREATED</defaultValue>
            </field>
            <field description="Show Empty Dashboard Message" name="showEmptyDashboardMessage" type="B">
              <help>Determines whether a message will be shown to users when viewing a dashboard that has no components on it. If enabled, displays a message and an Edit button when a dashboard contains no components. This helps users understand the state of the dashboard and encourages them to start adding content. When disabled, no message is displayed on empty dashboards, resulting in a somewhat confusing blank dashboard when no components are present.</help>
              <defaultValue>1</defaultValue>
            </field>
            <field description="Printable" name="printable" type="B">
              <help>Dashboard type for creating printable reports</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Page Settings" name="pageSettings" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647"/>
                </table>
              </defaultValue>
            </field>
            <field description="Name" name="name" nullable="true" type="S">
              <help>Unique name of the UI component within the dashboard. Since all UI components are represented by contexts located in the two-level component context tree, a component&apos;s name also equals to both the name and full path of the component context.</help>
              <defaultValue/>
            </field>
          </fields>
        </format>
      </entry>
      <entry>
        <int>6</int>
        <format maxRecords="2147483647" reorderable="true">
          <fields>
            <field hidden="true" keyfield="true" name="bindingId" notReplicated="true" nullable="true" type="L">
              <validators contentType="base64">HEweMCA5MjIzMzcyMDM2ODU0Nzc1ODA3HQ==</validators>
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
            <field description="Цель" editor="target" name="target" type="S">
              <help>Ссылка на объект, на который действует привязка.</help>
              <defaultValue/>
            </field>
            <field description="Выражение" editor="expression" name="expression" type="S">
              <help>Выражение, результат вычисления которого записывается в цель привязки.</help>
              <defaultValue/>
            </field>
            <field description="Активатор" editor="activator" name="activator" type="S">
              <help>Ссылка на событие или свойство, которое вызовет выполнение привязки. Если активатор не указан, а флаг &quot;При событии&quot; установлен, обработка привязки будет происходить при каждом изменении любого из компонентов выражения.</help>
              <defaultValue/>
            </field>
            <field description="Условие" editor="expression" name="condition" type="S">
              <help>Выражение, которое вычисляется при активации привязки. Результатом выражения должно быть булевское значение, которое указывает выполнять данную привязку или нет.</help>
              <defaultValue/>
            </field>
            <field description="При запуске" name="onstartup" type="B">
              <help>Если включено, то привязка будет выполняться один раз при запуске виджета.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="При событии" name="onevent" type="B">
              <help>Если включено, то привязка будет выполняться на каждое срабатывание активатора, или на изменение любой переменной из выражения, если активатор не указан.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Периодически" name="periodically" type="B">
              <help>Если включено, то привязка будет выполняться периодически.</help>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Период" editor="period" name="period" type="L">
              <validators contentType="base64">HEweMSA5MjIzMzcyMDM2ODU0Nzc1ODA3HQ==</validators>
              <help>Интервал периодического выполнения привязки.</help>
              <defaultValue>60000</defaultValue>
            </field>
            <field advanced="true" description="Очередь" name="queue" type="S">
              <validators contentType="base64">HFIeXHcqXl7QmNC80Y8g0LzQvtC20LXRgiDRgdC+0LTQtdGA0LbQsNGC0Ywg0YLQvtC70YzQutC+INC70LDRgtC40L3RgdC60LjQtSDQsdGD0LrQstGLLCDRhtC40YTRgNGLINC4INGB0LjQvNCy0L7Qu9GLINC/0L7QtNGH0LXRgNC60LjQstCw0L3QuNGPHQ==</validators>
              <help>Для целевых операций привязок, находящихся в одной очереди, гарантируется последовательное выполнение.</help>
              <defaultValue/>
            </field>
          </fields>
          <bindings>
            <binding>
              <reference>expression#options</reference>
              <expression>expressionEditorOptions({.:})</expression>
            </binding>
            <binding>
              <reference>activator#enabled</reference>
              <expression>{onevent}</expression>
            </binding>
            <binding>
              <reference>period#enabled</reference>
              <expression>{periodically}</expression>
            </binding>
            <binding>
              <reference>bindingId</reference>
              <expression>{bindingId}==null ? long(random()*9223372036854775807) : {bindingId}</expression>
            </binding>
          </bindings>
        </format>
      </entry>
      <entry>
        <int>7</int>
        <format maxRecords="1" minRecords="1">
          <fields>
            <field description="Тип" name="imageType" type="I">
              <selectionValues>
                <option description="Бинарный блок">0</option>
                <option description="URL">1</option>
              </selectionValues>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Данные изображения" name="imageData" type="A">
              <defaultValue>
                <data>
                  <nullValue/>
                </data>
              </defaultValue>
            </field>
            <field description="Ссылка на изображение" name="imageUrl" type="S">
              <defaultValue/>
            </field>
          </fields>
        </format>
      </entry>
      <entry>
        <int>8</int>
        <format maxRecords="2147483647">
          <fields>
            <field description="Переменная" keyfield="true" name="variable" type="S">
              <defaultValue/>
            </field>
            <field description="Тип хранения" name="layoutStorage" type="S">
              <selectionValues>
                <option description="Общее">shared</option>
                <option description="Для каждого логина">forEveryLogin</option>
                <option description="Для каждого пользователя">forEveryUser</option>
              </selectionValues>
              <defaultValue>shared</defaultValue>
            </field>
          </fields>
          <bindings>
            <binding>
              <reference>variable#choices</reference>
              <expression>{.:variableSelection()}</expression>
            </binding>
          </bindings>
          <validators contentType="base64">HEseHQ==</validators>
        </format>
      </entry>
      <entry>
        <int>9</int>
        <format maxRecords="2147483647">
          <fields>
            <field name="path" type="S">
              <defaultValue/>
            </field>
          </fields>
        </format>
      </entry>
      <entry>
        <int>10</int>
        <format maxRecords="2147483647">
          <fields>
            <field description="childContexts" name="childContexts" type="S">
              <defaultValue/>
            </field>
          </fields>
        </format>
      </entry>
      <entry>
        <int>11</int>
        <format maxRecords="1" minRecords="1">
          <fields>
            <field description="Минимальное количество записей" name="minRecords" type="I">
              <validators contentType="base64">HEweMCAyMTQ3NDgzNjQ3HQ==</validators>
              <defaultValue>0</defaultValue>
            </field>
            <field description="Максимальное количество записей" extendableSelectionValues="true" name="maxRecords" type="I">
              <validators contentType="base64">HEweMCAyMTQ3NDgzNjQ3HQ==</validators>
              <selectionValues>
                <option description="Не ограничено">2147483647</option>
              </selectionValues>
              <defaultValue>2147483647</defaultValue>
            </field>
            <field description="Поля" name="fields" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647" reorderable="true">
                    <fields>
                      <field hidden="true" name="oldname" type="S">
                        <defaultValue/>
                      </field>
                      <field description="Имя" keyfield="true" name="name" type="S">
                        <validators contentType="base64">HFIeXHcrXl7QmNC80Y8g0LzQvtC20LXRgiDRgdC+0LTQtdGA0LbQsNGC0Ywg0YLQvtC70YzQutC+INC70LDRgtC40L3RgdC60LjQtSDQsdGD0LrQstGLLCDRhtC40YTRgNGLINC4INGB0LjQvNCy0L7Qu9GLINC/0L7QtNGH0LXRgNC60LjQstCw0L3QuNGPHQ==</validators>
                        <defaultValue/>
                      </field>
                      <field description="Тип" name="type" type="S">
                        <selectionValues>
                          <option description="Бинарный блок">A</option>
                          <option description="Булевский">B</option>
                          <option description="Строковый">S</option>
                          <option description="Цвет">C</option>
                          <option description="Дата">D</option>
                          <option description="Табличный">T</option>
                          <option description="С плавающей запятой (64-бит)">E</option>
                          <option description="С плавающей запятой">F</option>
                          <option description="Целочисленный">I</option>
                          <option description="Длинный целочисленный">L</option>
                        </selectionValues>
                        <defaultValue>I</defaultValue>
                      </field>
                      <field description="Описание" name="description" nullable="true" type="S">
                        <validators contentType="base64">HFIeW15ccHtDbnRybH1dKl5e0J7Qv9C40YHQsNC90LjQtSDQvNC+0LbQtdGCINGB0L7QtNC10YDQttCw0YLRjCDRgtC+0LvRjNC60L4g0L/QtdGH0LDRgtC90YvQtSDRgdC40LzQstC+0LvRix0=</validators>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="По умолчанию" name="defaultValue" nullable="true" type="S">
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="Неизменяемое" name="readonly" type="B">
                        <defaultValue>0</defaultValue>
                      </field>
                      <field description="Может быть NULL" name="nullable" type="B">
                        <defaultValue>0</defaultValue>
                      </field>
                      <field description="Ключевое" name="key" type="B">
                        <defaultValue>0</defaultValue>
                      </field>
                      <field description="Допустимые значения" name="selvals" type="T">
                        <defaultValue>
                          <table>
                            <format maxRecords="2147483647" reorderable="true">
                              <fields>
                                <field description="Значение" keyfield="true" name="value" nullable="true" type="S">
                                  <defaultValue>
                                    <nullValue/>
                                  </defaultValue>
                                </field>
                                <field description="Описание" name="description" type="S">
                                  <validators contentType="base64">HEweMSAyMTQ3NDgzNjQ3HQ==</validators>
                                  <defaultValue/>
                                </field>
                              </fields>
                              <validators contentType="base64">HEseHQ==</validators>
                            </format>
                          </table>
                        </defaultValue>
                      </field>
                      <field description="Расширяемые допустимые значения" name="extselvals" type="B">
                        <defaultValue>0</defaultValue>
                      </field>
                      <field advanced="true" description="Скрытый" name="hidden" type="B">
                        <defaultValue>0</defaultValue>
                      </field>
                      <field advanced="true" description="Встроенное" name="inline" type="B">
                        <defaultValue>0</defaultValue>
                      </field>
                      <field advanced="true" description="Зашифрованное" name="encrypted" type="B">
                        <defaultValue>0</defaultValue>
                      </field>
                      <field description="Справка" editor="textarea" name="help" nullable="true" type="S">
                        <validators contentType="base64">HFIeW15ccHtDbnRybH1dKl5e0J7Qv9C40YHQsNC90LjQtSDQvNC+0LbQtdGCINGB0L7QtNC10YDQttCw0YLRjCDRgtC+0LvRjNC60L4g0L/QtdGH0LDRgtC90YvQtSDRgdC40LzQstC+0LvRix0=</validators>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="Редактор" extendableSelectionValues="true" name="editor" nullable="true" type="S">
                        <selectionValues>
                          <option description="По умолчанию">
                            <nullValue/>
                          </option>
                          <option description="Дата">date</option>
                          <option description="Формат значения">formatString</option>
                          <option description="Экземпляр класса">instance</option>
                          <option description="Редактор кода">code</option>
                          <option description="Временной диапазон">dateRange</option>
                          <option description="Выбор функции">functionselector</option>
                          <option description="Звук">sound</option>
                          <option description="Текстовая область">textarea</option>
                          <option description="Бокс">box</option>
                          <option description="Ссылка">reference</option>
                          <option description="Индикатор">bar</option>
                          <option description="Пароль">password</option>
                          <option description="Уровень события">eventLevel</option>
                          <option description="Контекст">context</option>
                          <option description="HTML">html</option>
                          <option description="Hex">hex</option>
                          <option description="Текстовый редактор">text</option>
                          <option description="Счетчик">spinner</option>
                          <option description="Изображение">image</option>
                          <option description="Период времени">period</option>
                          <option description="Выражение">expression</option>
                          <option description="IP адрес">ip</option>
                          <option description="Список">list</option>
                          <option description="Встроенная текстовая область">etextarea</option>
                          <option description="Экземпляр внешнего класса">foreignInstance</option>
                          <option description="Маска контекстов">contextmask</option>
                          <option description="Байты">bytes</option>
                          <option description="Время">time</option>
                          <option description="Активатор">activator</option>
                          <option description="Шрифт">font</option>
                        </selectionValues>
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="Опции редактора" name="editorOptions" nullable="true" type="T">
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                      <field description="Валидаторы" name="validators" nullable="true" type="T">
                        <defaultValue>
                          <table>
                            <format maxRecords="2147483647" reorderable="true">
                              <fields>
                                <field description="Тип" name="validator" nullable="true" type="S">
                                  <selectionValues>
                                    <option description="По умолчанию">
                                      <nullValue/>
                                    </option>
                                    <option description="Валидатор регулярных выражений">R</option>
                                    <option description="Валидатор выражений">E</option>
                                    <option description="Валидатор идентификаторов">I</option>
                                    <option description="Валидатор лимитов">L</option>
                                    <option description="Ненулевой Валидатор">N</option>
                                  </selectionValues>
                                  <defaultValue>
                                    <nullValue/>
                                  </defaultValue>
                                </field>
                                <field description="Параметры" name="options" type="S">
                                  <defaultValue/>
                                </field>
                              </fields>
                            </format>
                          </table>
                        </defaultValue>
                      </field>
                      <field description="Группа" name="group" nullable="true" type="S">
                        <defaultValue>
                          <nullValue/>
                        </defaultValue>
                      </field>
                    </fields>
                    <bindings>
                      <binding>
                        <reference>editorOptions</reference>
                        <expression>callFunction(&quot;utilities&quot;, &quot;editorOptions&quot;, {type}, {editor}, {editorOptions})</expression>
                      </binding>
                      <binding>
                        <reference>editor#choices</reference>
                        <expression>{utilities:editors(&apos;{type}&apos;)}</expression>
                      </binding>
                    </bindings>
                    <validators contentType="base64">HEseHQ==</validators>
                  </format>
                </table>
              </defaultValue>
