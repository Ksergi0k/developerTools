                    <field description="Максимизируемый" name="maximizable" type="B">
                      <defaultValue>1</defaultValue>
                    </field>
                    <field description="Сворачиваемый" name="collapsible" type="B">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Подвижный" name="dockMovable" type="B">
                      <defaultValue>1</defaultValue>
                    </field>
                    <field description="Свернутый" name="dockCollapsed" type="B">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Плавающий" name="dockFloatable" type="B">
                      <defaultValue>1</defaultValue>
                    </field>
                    <field description="Изменяемый" name="dockResizable" type="B">
                      <defaultValue>1</defaultValue>
                    </field>
                    <field description="Расположение вкладок" name="dockTabPosition" type="S">
                      <selectionValues>
                        <option description="Вверху">top</option>
                        <option description="Внизу">bottom</option>
                        <option description="Слева">left</option>
                        <option description="Справа">right</option>
                      </selectionValues>
                      <defaultValue>top</defaultValue>
                    </field>
                    <field description="Предпочитаемая ширина" name="dockPreferredWidth" type="I">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Предпочитаемая высота" name="dockPreferredHeight" type="I">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Минимальная ширина" name="dockMinimumWidth" type="I">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Минимальная высота" name="dockMinimumHeight" type="I">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="ID вкладки" name="tabId" type="S">
                      <defaultValue/>
                    </field>
                    <field description="ID Панели" name="panelId" type="S">
                      <defaultValue/>
                    </field>
                    <field description="Order ID" name="orderId" type="I">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Активный" name="active" type="B">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Горизонтальное Положение" name="gridx" type="I">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Вертикальное Положение" name="gridy" type="I">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Ширина контейнера" name="gridWidth" type="I">
                      <validators contentType="base64">HEweMSAyMTQ3NDgzNjQ3HQ==</validators>
                      <defaultValue>1</defaultValue>
                    </field>
                    <field description="Высота контейнера" name="gridHeight" type="I">
                      <validators contentType="base64">HEweMSAyMTQ3NDgzNjQ3HQ==</validators>
                      <defaultValue>1</defaultValue>
                    </field>
                    <field description="Пользовательские классы" name="customClasses" type="S">
                      <defaultValue/>
                    </field>
                    <field description="Стиль CSS элемента" editor="code" name="style" nullable="true" type="S">
                      <editorOptions>scss</editorOptions>
                      <defaultValue>
                        <nullValue/>
                      </defaultValue>
                    </field>
                    <field description="Видимые дети" name="visibleChildren" type="T">
                      <defaultValue>
                        <table>
                          <format maxRecords="2147483647"/>
                        </table>
                      </defaultValue>
                    </field>
                    <field description="Стиль обёртки" editor="code" name="containerStyle" nullable="true" type="S">
                      <editorOptions>scss</editorOptions>
                      <help>CSS стиль, который будет применен к обёртке компонента.</help>
                      <defaultValue>
                        <nullValue/>
                      </defaultValue>
                    </field>
                    <field description="Имя класса" name="preloaderClass" type="S">
                      <defaultValue/>
                    </field>
                    <field description="Текст" name="preloaderText" type="S">
                      <defaultValue/>
                    </field>
                    <field description="Видимый" name="preloaderVisible" type="B">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Пиктограмма" name="preloaderIcon" type="T">
                      <defaultValue>
                        <table>
                          <format maxRecords="2147483647"/>
                        </table>
                      </defaultValue>
                    </field>
                    <field description="Генерировать события &quot;Щелчок мыши&quot;" name="generateMouseClicked" type="B">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Генерировать события &quot;Двойной щелчок мыши&quot;" name="generateMouseDoubleClicked" type="B">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Генерировать события &quot;Кнопка мыши нажата&quot;" name="generateMousePressed" type="B">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Генерировать события &quot;Кнопка мыши отпущена&quot;" name="generateMouseReleased" type="B">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Генерировать события &quot;Наведение указателя мыши&quot;" name="generateMouseEntered" type="B">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Генерировать события &quot;Вывод указателя мыши&quot;" name="generateMouseExited" type="B">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Генерировать события &quot;Кнопка нажата&quot;" name="generateKeyPressed" type="B">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Генерировать события &quot;Кнопка отпущена&quot;" name="generateKeyReleased" type="B">
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Привязки компонента" name="componentBindings" type="T">
                      <defaultValue>
                        <table>
                          <format maxRecords="2147483647"/>
                        </table>
                      </defaultValue>
                    </field>
                    <field description="Текст" name="text" nullable="true" type="S">
                      <defaultValue>
                        <nullValue/>
                      </defaultValue>
                    </field>
                    <field description="Заполнитель" name="placeholder" nullable="true" type="S">
                      <defaultValue>
                        <nullValue/>
                      </defaultValue>
                    </field>
                    <field description="Неактивный" name="disabled" type="B">
                      <group>default</group>
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Изменяемый" name="resize" type="S">
                      <selectionValues>
                        <option description="Оба">both</option>
                        <option description="Горизонтально">horizontal</option>
                        <option description="Вертикально">vertical</option>
                        <option description="Отсутствует">none</option>
                      </selectionValues>
                      <defaultValue>none</defaultValue>
                    </field>
                    <field description="Максимальная длинна" name="maxLength" type="I">
                      <defaultValue>4096</defaultValue>
                    </field>
                    <field description="Содержимое" editor="html" name="tooltipContent" type="S">
                      <defaultValue/>
                    </field>
                    <field description="Размещение" name="tooltipPlacement" type="S">
                      <selectionValues>
                        <option description="Вверху">top</option>
                        <option description="Сверху Справа">topRight</option>
                        <option description="Сверху Слева">topLeft</option>
                        <option description="Справа">right</option>
                        <option description="Справа сверху">rightTop</option>
                        <option description="Справа снизу">rightBottom</option>
                        <option description="Внизу">bottom</option>
                        <option description="Внизу Справа">bottomRight</option>
                        <option description="Внизу Слева">bottomLeft</option>
                        <option description="Слева">left</option>
                        <option description="Слева сверху">leftTop</option>
                        <option description="Слева снизу">leftBottom</option>
                      </selectionValues>
                      <defaultValue>topLeft</defaultValue>
                    </field>
                    <field description="Цвет" name="tooltipColor" type="C">
                      <defaultValue>#404040FF</defaultValue>
                    </field>
                    <field description="Задержка при наведении мыши" editor="period" name="tooltipMouseEnterDelay" type="L">
                      <editorOptions>0 1</editorOptions>
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Задержка при выходе мыши" editor="period" name="tooltipMouseLeaveDelay" type="L">
                      <editorOptions>0 1</editorOptions>
                      <defaultValue>0</defaultValue>
                    </field>
                    <field description="Имя класса" name="tooltipClassName" type="S">
                      <defaultValue/>
                    </field>
                    <field description="Стиль" editor="code" name="tooltipContentStyle" nullable="true" type="S">
                      <editorOptions>scss</editorOptions>
                      <defaultValue>
                        <nullValue/>
                      </defaultValue>
                    </field>
                  </fields>
                </format>
                <records>
                  <record>
                    <value name="name">textAreaSessionNotes</value>
                    <value name="variablesStorage">
                      <table>
                        <format maxRecords="2147483647">
                          <fields>
                            <field description="Переменная" keyfield="true" name="variable" type="S">
                              <defaultValue/>
                            </field>
                            <field description="Тип хранения" name="layoutStorage" type="S">
                              <selectionValues>
                                <option description="Общее">shared</option>
                                <option description="Для каждого пользователя">forEveryUser</option>
                                <option description="Для каждого логина">forEveryLogin</option>
                              </selectionValues>
                              <defaultValue>shared</defaultValue>
                            </field>
                          </fields>
                          <bindings>
                            <binding>
                              <reference>variable#choices</reference>
                              <expression>{.:variableSelection()}</expression>
                            </binding>
                          </bindings>
                          <validators contentType="base64">HEseHQ==</validators>
                        </format>
                      </table>
                    </value>
                    <value name="gridBreakpoints">
                      <table>
                        <format maxRecords="2147483647">
                          <fields>
                            <field description="Точка остановы" name="breakpoint" nullable="true" type="S">
                              <defaultValue>default</defaultValue>
                            </field>
                            <field description="Стиль" name="style" nullable="true" type="S">
                              <defaultValue/>
                            </field>
                            <field description="Стиль обёртки" name="containerStyle" nullable="true" type="S">
                              <defaultValue/>
                            </field>
                          </fields>
                        </format>
                        <records>
                          <record>
                            <value name="breakpoint">none</value>
                            <value name="containerStyle">show-header:true*~*icon:{imageType=0, imageData={&quot;id&quot;: null, &quot;name&quot;: null, &quot;preview&quot;: &quot;null&quot;, &quot;data&quot;: null, &quot;shallow copy&quot;: false}, imageUrl=}*~*maximizable:true*~*collapsible:false*~*dock-movable:true*~*dock-collapsed:false*~*dock-floatable:true*~*dock-resizable:true*~*dock-tab-position:top*~*dock-preferred-width:0*~*dock-preferred-height:0*~*dock-minimum-width:0*~*dock-minimum-height:0*~*order-id:0*~*active:false*~*gridx:1*~*gridy:2*~*grid-width:12*~*grid-height:2*~*overflow:auto*~*container-style:.agg-textarea.agg-textarea {
  font-size: 21pt;
  line-height: 1;
}
.agg-textarea::placeholder { font-size: 21pt; }*~*</value>
                          </record>
                        </records>
                      </table>
                    </value>
                    <value name="icon">
                      <table>
                        <format maxRecords="1" minRecords="1">
                          <fields>
                            <field description="Тип" name="imageType" type="I">
                              <selectionValues>
                                <option description="Бинарный блок">0</option>
                                <option description="URL">1</option>
                              </selectionValues>
                              <defaultValue>0</defaultValue>
                            </field>
                            <field description="Данные изображения" name="imageData" type="A">
                              <defaultValue>
                                <data>
                                  <nullValue/>
                                </data>
                              </defaultValue>
                            </field>
                            <field description="Ссылка на изображение" name="imageUrl" type="S">
                              <defaultValue/>
                            </field>
                          </fields>
                        </format>
                        <records>
                          <record/>
                        </records>
                      </table>
                    </value>
                    <value name="gridx">1</value>
                    <value name="gridy">2</value>
                    <value name="gridWidth">12</value>
                    <value name="gridHeight">2</value>
                    <value name="style"/>
                    <value name="visibleChildren">
                      <table>
                        <format maxRecords="2147483647">
                          <fields>
                            <field name="path" type="S">
                              <defaultValue/>
                            </field>
                          </fields>
                        </format>
                      </table>
                    </value>
                    <value name="containerStyle">.agg-textarea.agg-textarea {
  font-size: 21pt;
  line-height: 1;
}
.agg-textarea::placeholder { font-size: 21pt; }</value>
                    <value name="preloaderIcon">
                      <table>
                        <format maxRecords="1" minRecords="1">
                          <fields>
                            <field description="Тип" name="imageType" type="I">
                              <selectionValues>
                                <option description="Бинарный блок">0</option>
                                <option description="URL">1</option>
                              </selectionValues>
                              <defaultValue>0</defaultValue>
                            </field>
                            <field description="Данные изображения" name="imageData" type="A">
                              <defaultValue>
                                <data>
                                  <nullValue/>
                                </data>
                              </defaultValue>
                            </field>
                            <field description="Ссылка на изображение" name="imageUrl" type="S">
                              <defaultValue/>
                            </field>
                          </fields>
                        </format>
                        <records>
                          <record/>
                        </records>
                      </table>
                    </value>
                    <value name="text"/>
                    <value name="placeholder">Заметки</value>
                    <value name="maxLength">52428800</value>
                    <value name="tooltipPlacement">top</value>
                    <value name="tooltipMouseEnterDelay">100</value>
                    <value name="tooltipMouseLeaveDelay">100</value>
                    <value name="tooltipContentStyle"/>
                  </record>
                </records>
              </table>
            </value>
          </record>
        </records>
      </table>
    </entry>
    <entry>
      <string>additionalHeaders</string>
      <table>
        <format maxRecords="2147483647">
          <fields>
            <field description="Имя" name="name" type="S">
              <defaultValue/>
            </field>
            <field description="Выражение для значения" editor="expression" name="valueExpression" type="S">
              <defaultValue/>
            </field>
          </fields>
        </format>
      </table>
    </entry>
    <entry>
      <string>headContent</string>
      <table>
        <format maxRecords="2147483647" reorderable="true">
          <fields>
            <field description="Тип" name="type" type="S">
              <selectionValues>
                <option description="Тег">tag</option>
              </selectionValues>
              <defaultValue>tag</defaultValue>
            </field>
            <field description="Имя тега" name="name" nullable="true" type="S">
              <selectionValues>
                <option description="title">title</option>
                <option description="base">base</option>
                <option description="link">link</option>
                <option description="style">style</option>
                <option description="meta">meta</option>
                <option description="script">script</option>
                <option description="noscript">noscript</option>
                <option description="template">template</option>
              </selectionValues>
              <defaultValue>meta</defaultValue>
            </field>
            <field description="Атрибуты тега" name="attributes" nullable="true" type="T">
              <defaultValue>
                <table>
                  <format maxRecords="2147483647" reorderable="true">
                    <fields>
                      <field description="Имя" name="attributeName" type="S">
                        <defaultValue/>
                      </field>
                      <field description="Выражение для значения" editor="expression" name="attributeValueExpression" type="S">
                        <defaultValue/>
                      </field>
                    </fields>
                  </format>
                </table>
              </defaultValue>
            </field>
            <field description="Выражение для содержимого" editor="expression" name="contentExpression" nullable="true" type="S">
              <defaultValue>
                <nullValue/>
              </defaultValue>
            </field>
          </fields>
          <bindings>
            <binding>
              <reference>name#enabled</reference>
              <expression>{type} == &quot;tag&quot;</expression>
            </binding>
            <binding>
              <reference>attributes#enabled</reference>
              <expression>{type} == &quot;tag&quot;</expression>
            </binding>
          </bindings>
        </format>
        <records>
          <record>
            <value name="attributes">
              <table>
                <format maxRecords="2147483647" reorderable="true">
                  <fields>
                    <field description="Имя" name="attributeName" type="S">
                      <defaultValue/>
                    </field>
                    <field description="Выражение для значения" editor="expression" name="attributeValueExpression" type="S">
                      <defaultValue/>
                    </field>
                  </fields>
                </format>
                <records>
                  <record>
                    <value name="attributeName">name</value>
                    <value name="attributeValueExpression">&quot;viewport&quot;</value>
                  </record>
                  <record>
                    <value name="attributeName">content</value>
                    <value name="attributeValueExpression">&quot;user-scalable=no, width=device-width, initial-scale=1.0&quot;</value>
                  </record>
                </records>
              </table>
            </value>
            <value name="contentExpression"/>
          </record>
        </records>
      </table>
    </entry>
  </properties>
</properties>