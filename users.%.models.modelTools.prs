              <value name="name">updateFormat</value>
              <value name="inputformat">
                <table>
                  <formatId id="5"/>
                  <records>
                    <record>
                      <value name="minRecords">1</value>
                      <value name="maxRecords">1</value>
                      <value name="fields">
                        <table>
                          <formatId id="6"/>
                          <records>
                            <record>
                              <value name="name">table</value>
                              <value name="type">T</value>
                              <value name="editorOptions">
                                <table>
                                  <formatId id="9"/>
                                  <records>
                                    <record/>
                                  </records>
                                </table>
                              </value>
                            </record>
                            <record>
                              <value name="name">columnName</value>
                              <value name="type">S</value>
                              <value name="editorOptions">
                                <table>
                                  <formatId id="9"/>
                                  <records>
                                    <record/>
                                  </records>
                                </table>
                              </value>
                            </record>
                            <record>
                              <value name="name">newColumnFormat</value>
                              <value name="type">S</value>
                              <value name="editorOptions">
                                <table>
                                  <formatId id="9"/>
                                  <records>
                                    <record/>
