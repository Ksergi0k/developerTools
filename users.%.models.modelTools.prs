                              <fields>
                                <field description="Target" name="target" type="S">
                                  <selectionValues>
                                    <option description="Font Family">fontFamily</option>
                                    <option description="Font Size">fontSize</option>
                                    <option description="Bold">fontWeight</option>
                                    <option description="Italic">fontItalic</option>
                                    <option description="Strikethrough">strike</option>
                                    <option description="Underline">underline</option>
                                    <option description="Font Color">fontColor</option>
                                    <option description="Background Color">backgroundColor</option>
                                    <option description="Vertical Alignment">verticalAlign</option>
                                    <option description="Horizontal Alignment">horizontalAlignment</option>
                                    <option description="Border Top">borderTop</option>
                                    <option description="Border Left">borderLeft</option>
                                    <option description="Border Right">borderRight</option>
                                    <option description="Border Bottom">borderBottom</option>
                                    <option description="Text Transfer">textTransfer</option>
                                    <option description="Custom Classes">customCssClasses</option>
                                    <option description="Value">value</option>
                                    <option description="Format">cellFormat</option>
                                    <option description="Selection Values">selvals</option>
                                  </selectionValues>
                                  <defaultValue>fontFamily</defaultValue>
                                </field>
                                <field description="Range" name="range" type="S">
                                  <validators contentType="base64">HEweMSAyMTQ3NDgzNjQ3HRxSHihbQS1aXSspPyhbMC05XSspPyg6W0EtWl0rKFswLTldKyk/KT9eXlVzZSBBMSBub3RhdGlvbh0=</validators>
                                  <defaultValue/>
                                </field>
                                <field description="Condition" editor="expression" name="condition" type="S">
                                  <editorOptions contentType="base64"></editorOptions>
                                  <validators contentType="base64">HEweMSAyMTQ3NDgzNjQ3HQ==</validators>
                                  <defaultValue/>
                                </field>
                                <field description="Expression" editor="expression" name="expression" type="S">
                                  <validators contentType="base64">HEweMSAyMTQ3NDgzNjQ3HQ==</validators>
                                  <defaultValue/>
                                </field>
                              </fields>
                            </format>
                          </table>
                        </defaultValue>
                      </field>
                      <field description="Styles" name="styles" type="T">
                        <defaultValue>
                          <table>
                            <format maxRecords="2147483647">
                              <fields>
                                <field description="ID" keyfield="true" name="id" type="L">
                                  <defaultValue>0</defaultValue>
                                </field>
                                <field description="Style" name="style" type="T">
                                  <defaultValue>
                                    <table>
                                      <format maxRecords="1" minRecords="1">
                                        <fields>
                                          <field description="Font Family" name="fontFamily" nullable="true" type="S">
                                            <defaultValue>
                                              <nullValue/>
                                            </defaultValue>
                                          </field>
                                          <field description="Font Size" name="fontSize" type="I">
                                            <defaultValue>14</defaultValue>
                                          </field>
                                          <field description="Bold" name="fontWeight" type="B">
                                            <defaultValue>0</defaultValue>
                                          </field>
                                          <field description="Italic" name="fontItalic" type="B">
                                            <defaultValue>0</defaultValue>
                                          </field>
                                          <field description="Strikethrough" name="strike" type="B">
                                            <defaultValue>0</defaultValue>
                                          </field>
                                          <field description="Underline" name="underline" type="B">
                                            <defaultValue>0</defaultValue>
                                          </field>
