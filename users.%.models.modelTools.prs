              <value name="implementation">import com.tibbo.aggregate.common.context.*;&#xd;
import com.tibbo.aggregate.common.datatable.*;&#xd;
import com.tibbo.aggregate.common.server.*;&#xd;
&#xd;
import com.tibbo.linkserver.*;&#xd;
import com.tibbo.linkserver.context.*;&#xd;
&#xd;
import com.tibbo.aggregate.common.expression.function.table.TableFunction;&#xd;
import com.tibbo.aggregate.common.expression.*;&#xd;
         &#xd;
import com.tibbo.aggregate.common.datatable.encoding.*;&#xd;
&#xd;
public class %ScriptClassNamePattern% implements FunctionImplementation&#xd;
{&#xd;
  public DataTable execute(Context con, FunctionDefinition def, CallerController caller, RequestController request, DataTable parameters) throws ContextException&#xd;
  {&#xd;
    &#xd;
    String name = parameters.getRecord(0).getString(&quot;name&quot;);&#xd;
    String format = parameters.getRecord(0).getString(&quot;format&quot;);&#xd;
    &#xd;
    Expression expression = new Expression(&quot;table(\&quot;&quot; + format + &quot;\&quot;)&quot;);&#xd;
    &#xd;
    //Создаем Evaluator &#xd;
    DataTable dt = new SimpleDataTable();&#xd;
    Evaluator eval = new Evaluator(dt);&#xd;
    &#xd;
    //EvaluationEnvironment env = new EvaluationEnvironment();&#xd;
    //TableFunction func = new TableFunction();&#xd;
     &#xd;
    DataTable inputTable = new SimpleDataTable();&#xd;
    try{&#xd;
        inputTable = eval.evaluateToDataTable(expression);&#xd;
    } catch (Exception  e){&#xd;
          &#xd;
    }&#xd;
    TableFormat tableFormat = inputTable.getFormat(); &#xd;
    &#xd;
    DataTableBuilding dtb = new DataTableBuilding();&#xd;
     &#xd;
    ClassicEncodingSettings ces = new ClassicEncodingSettings(true);&#xd;
&#xd;
    DataTable formatAsTable = dtb.formatToTable(tableFormat,ces);&#xd;
    &#xd;
    DataTable modelVariables = con.getVariable(ModelContextConstants.V_MODEL_VARIABLES, caller).clone();&#xd;
    modelVariables.addRecord().setValue(&quot;name&quot;,name).setValue(&quot;format&quot;,formatAsTable).setValue(&quot;writable&quot;,true);&#xd;
 &#xd;
    con.setVariable(ModelContextConstants.V_MODEL_VARIABLES, caller, modelVariables);&#xd;
&#xd;
    return inputTable;&#xd;
  }&#xd;
}&#xd;
</value>
