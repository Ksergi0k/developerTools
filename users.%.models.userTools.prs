      <entry>
        <string>modelFunctions</string>
        <table>
          <formatId id="4"/>
          <records>
            <record>
              <value name="name">switchResources</value>
              <value name="inputformat">
                <table>
                  <formatId id="5"/>
                  <records>
                    <record>
                      <value name="reorderable">0</value>
                    </record>
                  </records>
                </table>
              </value>
              <value name="outputformat">
                <table>
                  <formatId id="5"/>
                  <records>
                    <record>
                      <value name="reorderable">0</value>
                    </record>
                  </records>
                </table>
              </value>
              <value name="help">Включает все ресурсы, при повторном вызове выключает все ресурсы, кроме задействованных</value>
              <value name="expression">records(filter({.:resources},&quot;!{available}&quot;)) &gt; 0&#xd;
? // Enable all&#xd;
setVariable(&#xd;
  dc()&#xd;
  ,&quot;resources&quot;&#xd;
  ,setMultiple(&#xd;
        {.:resources}&#xd;
      , &quot;available&quot;&#xd;
      , true&#xd;
    )&#xd;
)&#xd;
: // Disable all except in usage&#xd;
setVariable(&#xd;
  dc()&#xd;
  ,&quot;resources&quot;&#xd;
  ,subtable(&#xd;
    setMultiple(&#xd;
      addColumns(&#xd;
        {.:resources}&#xd;
        ,&quot;&lt;count&gt;&lt;S&gt;&quot;&#xd;
        ,&quot; catch(records(getVariable(&apos;users.&apos; + {.:childInfo$name[0]} + &apos;.&apos; + substring({pattern},index({pattern},&apos;%&apos;,0)+2),&apos;children&apos;)),0)&quot;&#xd;
      )&#xd;
      ,&quot;available&quot;&#xd;
      ,FALSE&#xd;
      ,&quot;{count} == 0&quot;&#xd;
&#xd;
    )&#xd;
    ,&quot;description&quot;&#xd;
    ,&quot;available&quot;&#xd;
  )&#xd;
)</value>
              <value name="inheritedFrom">false</value>
            </record>
            <record>
              <value name="name">showDevicesTypes</value>
              <value name="inputformat">
                <table>
                  <formatId id="5"/>
                  <records>
                    <record>
                      <value name="minRecords">1</value>
                      <value name="maxRecords">1</value>
                      <value name="fields">
                        <table>
                          <formatId id="6"/>
                          <records>
                            <record>
                              <value name="name">show</value>
                              <value name="type">B</value>
                              <value name="defaultValue">true</value>
                              <value name="editorOptions">
                                <table>
                                  <formatId id="7"/>
                                  <records>
                                    <record/>
                                  </records>
                                </table>
                              </value>
                            </record>
                          </records>
                        </table>
                      </value>
                      <value name="reorderable">0</value>
                    </record>
                  </records>
                </table>
              </value>
              <value name="outputformat">
                <table>
                  <formatId id="5"/>
                  <records>
                    <record>
                      <value name="reorderable">0</value>
                    </record>
                  </records>
                </table>
              </value>
              <value name="expression">aggregate(&#xd;
  dc()+&quot;.devices.*&quot;&#xd;
  ,&quot;setVariableField(dc(),&apos;genericProperties&apos;,&apos;showFullDeviceDescription&apos;,0,&quot;+{show}+&quot;)&quot;&#xd;
  ,&quot;&quot;&#xd;
)</value>
              <value name="inheritedFrom">false</value>
            </record>
          </records>
        </table>
      </entry>
